<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>GRepos</RootNamespace>
    <AssemblyName>GRepos</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Publicado já compilado, sem esperar o JIT na abertura: medido com 61 repositórios,
       a janela aparecia em 2,3 s e passou a 1,2 s, e a tela fica livre 1,5 s antes.
       Não composto: o composto embute o .NET inteiro (o standalone ia a 135 MB) e, deixado
       no obj, era reaproveitado pelo publish seguinte e derrubava o executável que depende
       do runtime instalado, antes mesmo do Main. Só no publish com runtime (-r win-x64):
       o build e os testes continuam como sempre. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != ''">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Sodium.Core" Version="1.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- controle do terminal embutido: cópia ajustada, ver vendor/AvaloniaTerminal -->
    <ProjectReference Include="../vendor/AvaloniaTerminal/AvaloniaTerminal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- os testes ajustam limites internos (ex.: o prazo das operações de rede) -->
    <InternalsVisibleTo Include="GRepos.Tests" />
  </ItemGroup>

</Project>
