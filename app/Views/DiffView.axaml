<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GRepos.ViewModels"
             xmlns:controls="using:GRepos.Controls"
             xmlns:local="using:GRepos"
             x:Class="GRepos.Views.DiffView"
             x:DataType="vm:DiffViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.code">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="8,1" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="None" />
    </Style>
    <!-- coluna do + e do −, separada do código como no GitHub: a indentação não anda -->
    <Style Selector="TextBlock.marcador">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="0,1" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    </Style>
    <Style Selector="TextBlock.gutter">
      <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Padding" Value="0,1,8,1" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
      <Setter Property="Background" Value="{DynamicResource GutterBg}" />
      <Setter Property="Width" Value="46" />
    </Style>
    <!-- o número da linha alterada ganha o tom mais forte: acha-se a mudança pela margem -->
    <Style Selector="TextBlock.gutter.add">
      <Setter Property="Background" Value="{DynamicResource AddGutter}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="TextBlock.gutter.del">
      <Setter Property="Background" Value="{DynamicResource DelGutter}" />
      <Setter Property="Foreground" Value="{DynamicResource Text}" />
    </Style>
    <Style Selector="Border.add">
      <Setter Property="Background" Value="{DynamicResource AddBg}" />
    </Style>
    <Style Selector="Border.del">
      <Setter Property="Background" Value="{DynamicResource DelBg}" />
    </Style>
    <Style Selector="Border.empty">
      <Setter Property="Background" Value="{DynamicResource GutterBg}" />
    </Style>
    <!-- linha escolhida para preparar sozinha: faixa na cor de destaque à esquerda.
         Toda linha reserva a faixa (transparente), para o texto não pular ao marcar -->
    <Style Selector="Border.linha">
      <Setter Property="BorderThickness" Value="3,0,0,0" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Border.linha.sel">
      <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Border.quadro">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="CornerRadius" Value="1.5" />
      <Setter Property="Margin" Value="1,0" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">

    <Border Grid.Row="0" Padding="10,6" Background="{DynamicResource BgPanel}"
            BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <TextBlock Grid.Column="0" Classes="mono dim" FontSize="12" Text="{Binding Title}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

        <!-- +N −N e os cinco quadros: o tamanho da mudança antes de ler o diff -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"
                    IsVisible="{Binding HasContent}">
          <TextBlock Classes="mono" FontSize="11.5" FontWeight="SemiBold" Text="{Binding AdicionadasTexto}"
                     Foreground="{DynamicResource Green}" VerticalAlignment="Center" />
          <TextBlock Classes="mono" FontSize="11.5" FontWeight="SemiBold" Text="{Binding RemovidasTexto}"
                     Foreground="{DynamicResource Red}" VerticalAlignment="Center" Margin="6,0,6,0" />
          <ItemsControl ItemsSource="{Binding Quadros}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="quadro"
                        Background="{Binding Converter={x:Static local:Converters.ResourceBrush}}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Button Grid.Column="2" Classes="tiny" Content="{Binding ContextoRotulo}" Margin="10,0,0,0"
                IsVisible="{Binding TemRecarga}" Command="{Binding AlternarContextoCommand}"
                ToolTip.Tip="Alterna entre só os blocos alterados e o arquivo inteiro com as alterações marcadas" />
        <Button Grid.Column="3" Classes="tiny" Content="Diff externo ↗" Margin="6,0,0,0"
                IsVisible="{Binding TemExterno}" Command="{Binding AbrirExternoCommand}"
                ToolTip.Tip="Abre o arquivo inteiro na ferramenta de comparação das Preferências" />
      </Grid>
    </Border>

    <TextBlock Grid.Row="1" Text="{Binding EmptyMessage}" Classes="faint"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               TextWrapping="Wrap" Margin="24"
               IsVisible="{Binding IsEmpty}" />

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="{Binding RolagemHorizontal}"
                  IsVisible="{Binding HasContent}">
      <ItemsControl Name="Linhas" ItemsSource="{Binding Rows}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.DataTemplates>

          <DataTemplate DataType="vm:DiffHeaderRow">
            <Border Background="{DynamicResource HunkBg}" Padding="10,3">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="mono dim" FontSize="11.5" Text="{Binding Header}"
                           VerticalAlignment="Center" />
                <Button Classes="tiny" Content="{Binding ApplyLabel}"
                        Command="{Binding ApplyCommand}"
                        IsVisible="{Binding CanApply}"
                        BorderThickness="1" BorderBrush="{DynamicResource Border}" />
                <Button Classes="tiny" Content="{Binding LinhasRotulo}"
                        Command="{Binding ApplyLinhasCommand}"
                        IsVisible="{Binding TemLinhas}"
                        BorderThickness="1" BorderBrush="{DynamicResource Accent}" />
                <TextBlock Classes="faint" FontSize="11" VerticalAlignment="Center"
                           IsVisible="{Binding MostrarDica}"
                           Text="ou clique nas linhas + e − para escolher só algumas" />
              </StackPanel>
            </Border>
          </DataTemplate>

          <DataTemplate DataType="vm:DiffTextRow">
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="gutter" Classes.add="{Binding IsAdd}" Classes.del="{Binding IsDel}"
                         Text="{Binding OldNo}" />
              <TextBlock Classes="gutter" Classes.add="{Binding IsAdd}" Classes.del="{Binding IsDel}"
                         Text="{Binding NewNo}" />
              <Border Classes="linha" Tag="U" Classes.sel="{Binding Escolhida}"
                      Classes.add="{Binding IsAdd}" Classes.del="{Binding IsDel}"
                      Width="{Binding $parent[ItemsControl].DataContext.UnifiedWidth}">
                <Grid ColumnDefinitions="18,*">
                  <TextBlock Grid.Column="0" Classes="marcador" Text="{Binding Marker}" />
                  <TextBlock Grid.Column="1" Classes="code" Padding="0,1,8,1"
                             controls:Codigo.Linha="{Binding Codigo}"
                             TextWrapping="{Binding $parent[ItemsControl].DataContext.Wrapping}" />
                </Grid>
              </Border>
            </StackPanel>
          </DataTemplate>

          <DataTemplate DataType="vm:DiffSplitRow">
            <StackPanel Orientation="Horizontal">
              <TextBlock Classes="gutter" Width="44" Classes.del="{Binding LeftIsDel}" Text="{Binding LeftNo}" />
              <Border Classes="linha" Tag="L" Classes.sel="{Binding LeftEscolhida}"
                      Classes.del="{Binding LeftIsDel}" Classes.empty="{Binding LeftEmpty}"
                      Width="{Binding $parent[ItemsControl].DataContext.LeftWidth}">
                <TextBlock Classes="code" controls:Codigo.Linha="{Binding LeftCodigo}"
                           TextWrapping="{Binding $parent[ItemsControl].DataContext.Wrapping}" />
              </Border>
              <TextBlock Classes="gutter" Width="44" Classes.add="{Binding RightIsAdd}" Text="{Binding RightNo}" />
              <Border Classes="linha" Tag="R" Classes.sel="{Binding RightEscolhida}"
                      Classes.add="{Binding RightIsAdd}" Classes.empty="{Binding RightEmpty}"
                      Width="{Binding $parent[ItemsControl].DataContext.RightWidth}">
                <TextBlock Classes="code" controls:Codigo.Linha="{Binding RightCodigo}"
                           TextWrapping="{Binding $parent[ItemsControl].DataContext.Wrapping}" />
              </Border>
            </StackPanel>
          </DataTemplate>

        </ItemsControl.DataTemplates>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
