<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GRepos.ViewModels"
        xmlns:local="using:GRepos"
        x:Class="GRepos.Views.EsteiraWindow"
        x:DataType="vm:EsteiraViewModel"
        Title="Esteira" Width="900" Height="640" MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Bg}">

  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="14">

    <!-- os botões que levam para fora (segredos, página no GitHub) ficam ao lado do nome:
         no rodapé, junto da legenda e do ritmo, não cabiam na largura com que a janela abre -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Subtitulo}" Classes="faint" FontSize="11"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0"
                  VerticalAlignment="Center">
        <Button Content="Segredos e variáveis…" Click="AbrirSegredos"
                ToolTip.Tip="Segredos e variáveis que os workflows deste repositório usam" />
        <Button Content="Abrir no GitHub" MinWidth="128" Command="{Binding AbrirNoGitHubCommand}" />
      </StackPanel>
    </Grid>

    <Border Grid.Row="1" Padding="12,9" CornerRadius="7" Margin="0,0,0,10"
            Background="{DynamicResource BgRaised}" BorderThickness="1"
            BorderBrush="{DynamicResource Red}" IsVisible="{Binding TemErro}">
      <TextBlock Text="{Binding Erro}" TextWrapping="Wrap" TextTrimming="None" />
    </Border>

    <!-- cartões à esquerda, passo a passo do cartão escolhido à direita -->
    <Grid Grid.Row="2" ColumnDefinitions="312,10,*">

      <Border Grid.Column="0" Classes="card" Padding="0" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*,Auto">
          <!-- contadores por situação que também filtram: clicar num deles restringe
               a lista, clicar de novo volta ao todo -->
          <Border Grid.Row="0" Padding="8,6" BorderBrush="{DynamicResource BorderSoft}"
                  BorderThickness="0,0,0,1">
            <StackPanel>
            <WrapPanel>
              <Button Classes="tiny" Content="{Binding RotuloTodas}" Margin="0,0,4,0"
                      Command="{Binding FiltrarCommand}" CommandParameter=""
                      ToolTip.Tip="Mostrar todas as execuções" />
              <Button Classes="tiny" Margin="0,0,4,0"
                      Command="{Binding FiltrarCommand}" CommandParameter="sucesso"
                      ToolTip.Tip="Só as que passaram">
                <TextBlock Text="{Binding RotuloSucesso}" FontSize="11"
                           Foreground="{DynamicResource Green}" />
              </Button>
              <Button Classes="tiny" Margin="0,0,4,0"
                      Command="{Binding FiltrarCommand}" CommandParameter="falha"
                      ToolTip.Tip="Só as que quebraram">
                <TextBlock Text="{Binding RotuloFalha}" FontSize="11"
                           Foreground="{DynamicResource Red}" />
              </Button>
              <Button Classes="tiny"
                      Command="{Binding FiltrarCommand}" CommandParameter="rodando"
                      ToolTip.Tip="Só as que estão rodando">
                <TextBlock Text="{Binding RotuloRodando}" FontSize="11"
                           Foreground="{DynamicResource Yellow}" />
              </Button>
            </WrapPanel>

            <!-- também filtra a lista, então mora com os contadores. Desmarcado mostra
                 também os builds de tag, cujo head_branch é o nome da tag -->
            <CheckBox FontSize="11" MinHeight="0" Margin="2,6,0,0"
                      IsVisible="{Binding PodeFiltrarPorBranch}"
                      IsChecked="{Binding SomenteBranch}"
                      ToolTip.Tip="Desmarcado, a lista inclui os builds de tag e de outras branches">
              <TextBlock Text="{Binding FiltroTexto}" Classes="dim" TextTrimming="CharacterEllipsis" />
            </CheckBox>
            </StackPanel>
          </Border>

          <TextBlock Grid.Row="1" Text="Carregando…" Classes="faint" Margin="12,10"
                     IsVisible="{Binding Carregando}" />
          <TextBlock Grid.Row="1" Text="{Binding TextoSemExecucoes}"
                     Classes="faint" Margin="12,10" TextWrapping="Wrap"
                     IsVisible="{Binding SemExecucoes}" />

          <ListBox Grid.Row="1" ItemsSource="{Binding Execucoes}"
                   SelectedItem="{Binding Selecionada}"
                   Background="Transparent" Padding="0,0,4,0">
            <ListBox.ItemTemplate>
              <DataTemplate DataType="vm:CiExecucaoViewModel">
                <Grid ColumnDefinitions="16,*,Auto" Margin="6,5" ToolTip.Tip="{Binding Tooltip}">
                  <TextBlock Grid.Column="0" Text="{Binding Simbolo}" FontSize="13"
                             VerticalAlignment="Top" Margin="0,1,0,0"
                             Foreground="{Binding Cor, Converter={x:Static local:Converters.ResourceBrush}}" />
                  <StackPanel Grid.Column="1" Margin="6,0,6,0">
                    <TextBlock Text="{Binding Workflow}" FontWeight="SemiBold" FontSize="12"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Titulo}" Classes="dim" FontSize="11.5"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Rodape}" Classes="faint" FontSize="10.5"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Numero}" Classes="faint" FontSize="10.5"
                             VerticalAlignment="Top" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <!-- o resto fica recolhido: a lista inteira do GitHub não cabe nem ajuda -->
          <Button Grid.Row="2" Classes="tiny" HorizontalAlignment="Center" Margin="0,5"
                  Content="{Binding TextoRecolhidas}" IsVisible="{Binding TemRecolhidas}"
                  Command="{Binding AlternarRecolhidasCommand}" />
        </Grid>
      </Border>

      <Border Grid.Column="2" Classes="card" Padding="0" ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">
          <!-- o que age sobre a execução escolhida fica em cima dos passos dela, como na
               página da execução no GitHub. Os três confirmam antes -->
          <Border Grid.Row="0" Padding="10,6" BorderBrush="{DynamicResource BorderSoft}"
                  BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Grid.Column="0" Classes="sectionTitle" Text="PASSO A PASSO"
                         VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="8,0,0,0">
                <Button Classes="acao" Content="Reexecutar" IsEnabled="{Binding PodeReexecutar}"
                        Command="{Binding ReexecutarCommand}"
                        ToolTip.Tip="Roda de novo a execução selecionada" />
                <Button Classes="acao" Content="Só as falhas" IsEnabled="{Binding PodeReexecutarFalhas}"
                        Command="{Binding ReexecutarFalhasCommand}"
                        ToolTip.Tip="Roda de novo apenas os jobs que falharam" />
                <Button Classes="acao danger" Content="Parar" IsEnabled="{Binding PodeCancelar}"
                        Command="{Binding CancelarCommand}"
                        ToolTip.Tip="Cancela a execução selecionada, que ainda está rodando" />
              </StackPanel>
            </Grid>
          </Border>

          <TextBlock Grid.Row="1" Text="Escolha uma execução à esquerda." Classes="faint"
                     Margin="12,10" IsVisible="{Binding SemSelecao}" />
          <TextBlock Grid.Row="1" Text="Carregando os passos…" Classes="faint" Margin="12,10"
                     IsVisible="{Binding CarregandoJobs}" />
          <TextBlock Grid.Row="1" Text="Esta execução não detalhou os passos." Classes="faint"
                     Margin="12,10" TextWrapping="Wrap" IsVisible="{Binding SemJobs}" />

          <ScrollViewer Grid.Row="1" Padding="0,0,4,0">
            <StackPanel>
            <ItemsControl ItemsSource="{Binding Jobs}" Margin="10,8">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:CiJobViewModel">
                  <StackPanel Margin="0,0,0,14">
                    <Grid ColumnDefinitions="16,*,Auto,Auto" Margin="0,0,0,4">
                      <TextBlock Grid.Column="0" Text="{Binding Simbolo}" FontSize="13"
                                 VerticalAlignment="Center"
                                 Foreground="{Binding Cor, Converter={x:Static local:Converters.ResourceBrush}}" />
                      <TextBlock Grid.Column="1" Text="{Binding Nome}" FontWeight="SemiBold"
                                 FontSize="12" Margin="6,0" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="2" Text="{Binding DuracaoTexto}" Classes="faint"
                                 FontSize="10.5" VerticalAlignment="Center" />
                      <Button Grid.Column="3" Classes="tiny" Content="log" Margin="8,0,0,0"
                              ToolTip.Tip="Abrir o log inteiro deste job no editor de texto"
                              Command="{Binding $parent[Window].DataContext.AbrirLogDoJobCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>

                    <!-- clicar no passo abre o log dele logo abaixo, como no GitHub -->
                    <ItemsControl ItemsSource="{Binding Etapas}" Margin="22,0,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:CiEtapaViewModel">
                          <StackPanel>
                            <Button Classes="secaoTopo" Padding="0" Height="22"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    ToolTip.Tip="{Binding DicaDoPasso}"
                                    Command="{Binding $parent[Window].DataContext.AlternarLogCommand}"
                                    CommandParameter="{Binding}">
                              <Grid ColumnDefinitions="14,*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Simbolo}" FontSize="11"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Cor, Converter={x:Static local:Converters.ResourceBrush}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Nome}" FontSize="11.5"
                                           Margin="6,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding CorDoNome, Converter={x:Static local:Converters.ResourceBrush}}"
                                           FontWeight="{Binding Peso}" />
                                <TextBlock Grid.Column="2" Text="{Binding DuracaoTexto}" Classes="faint"
                                           FontSize="10.5" VerticalAlignment="Center" Margin="0,0,4,0" />
                              </Grid>
                            </Button>

                            <Border IsVisible="{Binding LogAberto}" Margin="0,2,0,8" Padding="8,6"
                                    CornerRadius="5" Background="{DynamicResource Bg}"
                                    BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
                              <StackPanel Spacing="6">
                                <TextBlock Text="Carregando o log…" Classes="faint" FontSize="11"
                                           IsVisible="{Binding CarregandoLog}" />
                                <TextBlock Text="{Binding LogAviso}" Classes="faint" FontSize="11"
                                           TextWrapping="Wrap" IsVisible="{Binding TemLogAviso}" />
                                <SelectableTextBlock Text="{Binding LogErros}" FontSize="11.5" TextWrapping="Wrap"
                                                     Foreground="{DynamicResource Red}" FontWeight="SemiBold"
                                                     IsVisible="{Binding TemLogErros}" />
                                <ScrollViewer MaxHeight="320" HorizontalScrollBarVisibility="Auto"
                                              IsVisible="{Binding TemLogTexto}">
                                  <SelectableTextBlock Text="{Binding LogTexto}" FontSize="11"
                                                       FontFamily="{DynamicResource MonoFont}" />
                                </ScrollViewer>
                              </StackPanel>
                            </Border>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- o que a execução gerou (upload-artifact): baixa e extrai, como o gh run download -->
            <StackPanel IsVisible="{Binding TemArtefatos}" Margin="10,0,10,10">
              <TextBlock Classes="sectionTitle" Text="ARTEFATOS" Margin="0,0,0,6" />
              <ItemsControl ItemsSource="{Binding Artefatos}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:ArtefatoViewModel">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,4">
                      <TextBlock Grid.Column="0" Text="{Binding Nome}" FontSize="12"
                                 VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1" Text="{Binding Detalhe}" Classes="faint" FontSize="10.5"
                                 VerticalAlignment="Center" Margin="8,0" />
                      <Button Grid.Column="2" Classes="tiny" Content="Baixar"
                              IsEnabled="{Binding PodeBaixar}"
                              ToolTip.Tip="Baixar e extrair numa pasta à sua escolha"
                              Command="{Binding $parent[Window].DataContext.BaixarArtefatoCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <!-- disparar um workflow: escreve no repositório, e confirma antes -->
    <Border Grid.Row="3" Classes="card" Padding="10,7" Margin="0,10,0,0">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
        <TextBlock Grid.Column="0" Text="Executar" Classes="faint" FontSize="11"
                   VerticalAlignment="Center" Margin="0,0,8,0" />
        <ComboBox Grid.Column="1" MinWidth="170" ItemsSource="{Binding Workflows}"
                  SelectedItem="{Binding WorkflowEscolhido}" VerticalAlignment="Center">
          <ComboBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Nome}" />
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Grid.Column="2" Text="em" Classes="faint" FontSize="11"
                   VerticalAlignment="Center" Margin="8,0" />
        <TextBox Grid.Column="3" Width="150" Text="{Binding Referencia}"
                 Watermark="branch ou tag" VerticalAlignment="Center" />

        <Button Grid.Column="5" Content="Executar" MinWidth="88" IsEnabled="{Binding PodeDisparar}"
                Command="{Binding DispararCommand}" VerticalAlignment="Center"
                ToolTip.Tip="Dispara o workflow no GitHub Actions" />
      </Grid>
    </Border>

    <Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,10,0,0">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock Text="✓" Foreground="{DynamicResource Green}" FontSize="12" />
          <TextBlock Text="passou" Classes="faint" FontSize="11" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock Text="✕" Foreground="{DynamicResource Red}" FontSize="12" />
          <TextBlock Text="quebrou" Classes="faint" FontSize="11" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="5">
          <TextBlock Text="●" Foreground="{DynamicResource Yellow}" FontSize="12" />
          <TextBlock Text="rodando" Classes="faint" FontSize="11" />
        </StackPanel>
      </StackPanel>

      <!-- na janela estreita o recado encurta, em vez de passar por baixo dos botões -->
      <TextBlock Grid.Column="1" Text="{Binding RitmoTexto}" Classes="faint" FontSize="11"
                 HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0"
                 TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RitmoTexto}" />

      <Button Grid.Column="2" Content="Atualizar" MinWidth="96" Margin="0,0,8,0"
              IsEnabled="{Binding !Carregando}" Command="{Binding CarregarCommand}" />
      <Button Grid.Column="3" Content="Fechar" MinWidth="88" Click="Fechar" />
    </Grid>
  </Grid>
</Window>
