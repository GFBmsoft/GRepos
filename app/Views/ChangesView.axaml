<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GRepos.ViewModels"
             xmlns:controls="using:GRepos.Controls"
             xmlns:views="using:GRepos.Views"
             xmlns:local="using:GRepos"
             x:Class="GRepos.Views.ChangesView"
             x:DataType="vm:ChangesViewModel">

  <UserControl.Resources>
    <local:IndexEqualsConverter x:Key="IndexEquals" />
  </UserControl.Resources>

  <Grid>
    <!-- com largura mínima: abaixo dela os botões da coluna não têm onde caber -->
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="320" MinWidth="260" />
      <ColumnDefinition Width="4" />
      <ColumnDefinition Width="*" MinWidth="300" />
    </Grid.ColumnDefinitions>

    <!-- arquivos + caixa de commit -->
    <Border Grid.Column="0" Classes="panel" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"
            ClipToBounds="True">
     <DockPanel>
      <!-- merge/rebase/cherry-pick parado: diz o que falta e como sair dele -->
      <Border DockPanel.Dock="Top" Padding="10,8" IsVisible="{Binding TemOperacao}"
              Background="{DynamicResource BgRaised}" BorderBrush="{DynamicResource Orange}"
              BorderThickness="0,0,0,2">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding OperacaoTexto}" TextWrapping="Wrap" FontSize="12" />
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
            <Button Classes="tiny danger" Content="Abortar" Command="{Binding AbortarOperacaoCommand}"
                    ToolTip.Tip="Desiste e volta ao estado de antes da operação" />
            <Button Classes="tiny" Content="{Binding ContinuarRotulo}" Command="{Binding ContinuarOperacaoCommand}"
                    ToolTip.Tip="Com todos os conflitos resolvidos, conclui a operação" />
          </StackPanel>
        </StackPanel>
      </Border>
      <!-- as duas listas dividem a altura e o divisor entre elas se arrasta: com muitos
           arquivos de um lado, dá para dar mais espaço a ele. Os mínimos guardam o
           cabeçalho com os botões e ao menos uma linha de arquivo -->
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="64" />
          <RowDefinition Height="5" />
          <RowDefinition Height="*" MinHeight="96" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

       <DockPanel Grid.Row="0">
        <Border DockPanel.Dock="Top" Padding="10,7" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto">
            <!-- com a coluna estreita é o título que é cortado, não o botão que sai dela -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" ClipToBounds="True">
              <TextBlock Classes="sectionTitle" Text="PREPARADO PARA COMMIT" />
              <TextBlock Classes="faint" FontSize="10" Margin="6,0,6,0"
                         VerticalAlignment="Center" Text="{Binding Staged.Count}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="pilula" Margin="6,0,0,0"
                    ToolTip.Tip="Tira do commit. Ctrl ou Shift + clique marcam vários arquivos."
                    Command="{Binding UnstageAllCommand}">
              <StackPanel Classes="comIcone">
                <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Tirar}" />
                <TextBlock Text="{Binding RemoverRotulo}" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <!-- Multiple: clique simples seleciona um; Ctrl ou Shift + clique marcam vários -->
        <ListBox Name="ListaStaged" SelectionMode="Multiple"
                 ItemsSource="{Binding Staged}" SelectedItem="{Binding SelectedStaged}">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Histórico do arquivo" Command="{Binding HistoricoDoArquivoCommand}">
                <MenuItem.Icon><TextBlock Classes="glifo azul" Text="{x:Static controls:Glifos.Historico}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Autoria das linhas (blame)" Command="{Binding AutoriaDoArquivoCommand}">
                <MenuItem.Icon><TextBlock Classes="glifo azul" Text="{x:Static controls:Glifos.Autoria}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Abrir no diff externo" Command="{Binding AbrirNoDiffExternoCommand}">
                <MenuItem.Icon><TextBlock Classes="glifo azul" Text="{x:Static controls:Glifos.Abrir}" /></MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:FileItemViewModel">
              <Grid ColumnDefinitions="18,*,Auto" Height="26" ToolTip.Tip="{Binding Tooltip}">
                <TextBlock Grid.Column="0" Text="{Binding Code}" FontFamily="{DynamicResource MonoFont}"
                           FontWeight="Bold" FontSize="11" TextAlignment="Center" VerticalAlignment="Center"
                           Foreground="{Binding CodeColor, Converter={x:Static local:Converters.ResourceBrush}}" />
                <TextBlock Grid.Column="1" Text="{Binding Path}" VerticalAlignment="Center"
                           FontSize="12" Margin="6,0" />
                <Button Grid.Column="2" Classes="pequena redonda" ToolTip.Tip="Remover do commit"
                        Command="{Binding $parent[ListBox].DataContext.UnstageCommand}"
                        CommandParameter="{Binding}">
                  <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Tirar}" />
                </Button>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
       </DockPanel>

        <!-- a linha que separa as listas é a alça: o divisor transparente fica por cima dela -->
        <Border Grid.Row="1" Height="1" VerticalAlignment="Center" IsHitTestVisible="False"
                Background="{DynamicResource BorderSoft}" />
        <GridSplitter Grid.Row="1" Background="Transparent" ResizeDirection="Rows"
                      ToolTip.Tip="Arraste para dividir a altura entre as duas listas" />

       <DockPanel Grid.Row="2">
        <Border DockPanel.Dock="Top" Padding="10,7" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1">
          <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,*">
            <TextBlock Grid.Column="0" Classes="sectionTitle" Text="ALTERAÇÕES LOCAIS" />
            <TextBlock Grid.Column="1" Classes="faint" FontSize="10" Margin="6,0,0,0"
                       VerticalAlignment="Center" Text="{Binding Unstaged.Count}" />
            <!-- ignorar não descarta nada: só tira da lista, e só nesta máquina -->
            <Button Grid.Column="2" Classes="pequena amarelo" HorizontalAlignment="Right"
                    ToolTip.Tip="Tira arquivos da lista de alterações só neste computador, sem mexer no repositório">
              <StackPanel Classes="comIcone">
                <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Ignorar}" />
                <TextBlock Text="Ignorar ▾" />
              </StackPanel>
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight">
                  <MenuItem Header="{Binding IgnorarRotulo}" Command="{Binding IgnorarTodosCommand}">
                    <MenuItem.Icon><TextBlock Classes="glifo amarelo" Text="{x:Static controls:Glifos.Ignorar}" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Ignorar o arquivo selecionado" Command="{Binding IgnorarArquivoCommand}">
                    <MenuItem.Icon><TextBlock Classes="glifo amarelo" Text="{x:Static controls:Glifos.Ignorar}" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="Adicionar o selecionado ao .gitignore"
                            Command="{Binding AdicionarAoGitignoreCommand}">
                    <MenuItem.Icon><TextBlock Classes="glifo amarelo" Text="{x:Static controls:Glifos.Documento}" /></MenuItem.Icon>
                  </MenuItem>
                  <Separator />
                  <MenuItem Header="{Binding IgnoradosRotulo}" Command="{Binding VerIgnoradosCommand}">
                    <MenuItem.Icon><TextBlock Classes="glifo azul" Text="{x:Static controls:Glifos.Ver}" /></MenuItem.Icon>
                  </MenuItem>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <!-- botões numa segunda linha: com "selecionados (N)" não cabem ao lado do título -->
            <!-- WrapPanel: sem largura para os dois lado a lado, o segundo desce em vez de
                 sair por cima do painel de diferenças -->
            <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Right" Margin="0,6,0,0"
                       LineSpacing="4">
              <Button Classes="pilula vermelho" Margin="6,0,0,0"
                      ToolTip.Tip="Desfaz as alterações locais (o que está preparado fica). Pede confirmação."
                      Command="{Binding DiscardAllCommand}">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Excluir}" />
                  <TextBlock Text="{Binding DescartarRotulo}" />
                </StackPanel>
              </Button>
              <Button Classes="pilula verde" Margin="6,0,0,0"
                      ToolTip.Tip="Prepara para commit. Ctrl ou Shift + clique marcam vários arquivos."
                      Command="{Binding StageAllCommand}">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Preparar}" />
                  <TextBlock Text="{Binding PrepararRotulo}" />
                </StackPanel>
              </Button>
            </WrapPanel>
          </Grid>
        </Border>

        <ListBox Name="ListaUnstaged" SelectionMode="Multiple"
                 ItemsSource="{Binding Unstaged}" SelectedItem="{Binding SelectedUnstaged}">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Histórico do arquivo" Command="{Binding HistoricoDoArquivoCommand}">
                <MenuItem.Icon><TextBlock Classes="glifo azul" Text="{x:Static controls:Glifos.Historico}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Autoria das linhas (blame)" Command="{Binding AutoriaDoArquivoCommand}">
                <MenuItem.Icon><TextBlock Classes="glifo azul" Text="{x:Static controls:Glifos.Autoria}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Abrir no diff externo" Command="{Binding AbrirNoDiffExternoCommand}">
                <MenuItem.Icon><TextBlock Classes="glifo azul" Text="{x:Static controls:Glifos.Abrir}" /></MenuItem.Icon>
              </MenuItem>
              <Separator />
              <MenuItem Header="Ignorar alterações (só nesta máquina)" Command="{Binding IgnorarArquivoCommand}">
                <MenuItem.Icon><TextBlock Classes="glifo amarelo" Text="{x:Static controls:Glifos.Ignorar}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Adicionar ao .gitignore" Command="{Binding AdicionarAoGitignoreCommand}">
                <MenuItem.Icon><TextBlock Classes="glifo amarelo" Text="{x:Static controls:Glifos.Documento}" /></MenuItem.Icon>
              </MenuItem>
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:FileItemViewModel">
              <Grid ColumnDefinitions="18,*,Auto,Auto" Height="26" ToolTip.Tip="{Binding Tooltip}">
                <TextBlock Grid.Column="0" Text="{Binding Code}" FontFamily="{DynamicResource MonoFont}"
                           FontWeight="Bold" FontSize="11" TextAlignment="Center" VerticalAlignment="Center"
                           Foreground="{Binding CodeColor, Converter={x:Static local:Converters.ResourceBrush}}" />
                <TextBlock Grid.Column="1" Text="{Binding Path}" VerticalAlignment="Center"
                           FontSize="12" Margin="6,0" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="2" Classes="pequena redonda vermelho" ToolTip.Tip="Descartar alterações"
                        IsVisible="{Binding CanDiscard}"
                        Command="{Binding $parent[ListBox].DataContext.DiscardCommand}"
                        CommandParameter="{Binding}">
                  <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Desfazer}" />
                </Button>
                <Button Grid.Column="3" Classes="pequena redonda verde" ToolTip.Tip="Preparar para commit"
                        Margin="3,0,0,0" IsVisible="{Binding PodePreparar}"
                        Command="{Binding $parent[ListBox].DataContext.StageCommand}"
                        CommandParameter="{Binding}">
                  <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Preparar}" />
                </Button>
                <!-- conflito: fica inteiro com um dos lados, ou marca o que foi acertado no editor -->
                <StackPanel Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="3"
                            IsVisible="{Binding IsConflito}">
                  <Button Classes="pequena roxo" Content="Resolver" IsVisible="{Binding ConflitoDeConteudo}"
                          ToolTip.Tip="Resolver bloco a bloco: o meu, o deles e o resultado"
                          Command="{Binding $parent[ListBox].DataContext.ResolverConflitoCommand}"
                          CommandParameter="{Binding}" />
                  <Button Classes="pequena azul" Content="Meu"
                          ToolTip.Tip="Fica com a versão da sua branch (descarta a que está chegando)"
                          Command="{Binding $parent[ListBox].DataContext.ManterMeuCommand}"
                          CommandParameter="{Binding}" />
                  <Button Classes="pequena azul" Content="Deles"
                          ToolTip.Tip="Fica com a versão que está chegando (descarta a sua)"
                          Command="{Binding $parent[ListBox].DataContext.ManterDelesCommand}"
                          CommandParameter="{Binding}" />
                  <Button Classes="pequena redonda verde"
                          ToolTip.Tip="Já resolvi no editor: marcar como resolvido"
                          Command="{Binding $parent[ListBox].DataContext.MarcarResolvidoCommand}"
                          CommandParameter="{Binding}">
                    <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Finalizar}" />
                  </Button>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
       </DockPanel>

        <Border Grid.Row="3" Padding="8" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
          <StackPanel Spacing="7">
            <TextBox Name="Mensagem" Watermark="Mensagem de commit (Ctrl+Enter faz o commit)"
                     AcceptsReturn="True" MinHeight="64"
                     TextWrapping="Wrap" Text="{Binding CommitMessage}" />
            <!-- os botões têm lugar garantido; quem encolhe (com reticências) é o rótulo da caixa -->
            <Grid ColumnDefinitions="*,0,Auto,Auto">
              <CheckBox Grid.Column="0" IsChecked="{Binding Amend}" HorizontalAlignment="Left"
                        ClipToBounds="True" ToolTip.Tip="Emendar o último commit em vez de criar um novo">
                <TextBlock Text="Emendar último" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
              </CheckBox>
              <!-- reverter o repositório inteiro fica junto do commit: também vale para tudo -->
              <Button Grid.Column="2" Name="Reverter" Classes="redonda vermelho" Margin="0,0,6,0"
                      ToolTip.Tip="Reverter: volta o repositório ao estado da branch, descartando tudo">
                <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Resetar}" />
                <Button.Flyout>
                  <MenuFlyout Placement="TopEdgeAlignedRight">
                    <MenuItem Header="Voltar ao último commit (descarta preparados e locais)"
                              Command="{Binding VoltarAoUltimoCommitCommand}">
                      <MenuItem.Icon><TextBlock Classes="glifo vermelho" Text="{x:Static controls:Glifos.Resetar}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="{Binding VoltarAoRemotoRotulo}" IsEnabled="{Binding TemRemoto}"
                              Command="{Binding VoltarAoRemotoCommand}">
                      <MenuItem.Icon><TextBlock Classes="glifo vermelho" Text="{x:Static controls:Glifos.Resetar}" /></MenuItem.Icon>
                    </MenuItem>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
              <Button Grid.Column="3" Classes="primary verde"
                      IsEnabled="{Binding CanCommit}" Command="{Binding CommitCommand}">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Commit}" />
                  <TextBlock Text="{Binding CommitCaption}" />
                </StackPanel>
              </Button>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
     </DockPanel>
    </Border>

    <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

    <views:DiffView Grid.Column="2" DataContext="{Binding Diff}" />
  </Grid>
</UserControl>
