<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GRepos.ViewModels"
             xmlns:views="using:GRepos.Views"
             xmlns:controls="using:GRepos.Controls"
             xmlns:local="using:GRepos"
             x:Class="GRepos.Views.HistoryView"
             x:DataType="vm:HistoryViewModel">

  <!-- as colunas fixas cedem ao espaço (ColunaQueCede). O mínimo da direita é o que cabe a
       lista de arquivos no mínimo dela, o divisor e o diff -->
  <Grid x:Name="ListaEDetalhe">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="420" MinWidth="240" />
      <ColumnDefinition Width="4" />
      <ColumnDefinition Width="*" MinWidth="494" />
    </Grid.ColumnDefinitions>

    <!-- lista de commits com o grafo -->
    <Border Grid.Column="0" Classes="panel" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="10,7" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Column="0" Classes="sectionTitle" Text="HISTÓRICO" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Classes="faint" FontSize="10" Margin="6,0,0,0"
                       VerticalAlignment="Center" Text="{Binding ContagemTexto}" />
            <CheckBox Grid.Column="3" Content="todas as branches" IsChecked="{Binding AllBranches}" />
            <!-- busca no git, não só no que está carregado: acha commit antigo fora do limite -->
            <TextBox Grid.Row="1" Grid.ColumnSpan="4" Margin="0,6,0,0"
                     Watermark="Buscar por mensagem, autor ou hash..." Text="{Binding Busca}">
              <TextBox.InnerRightContent>
                <Button Classes="tiny" Content="&#x2715;" ToolTip.Tip="Limpar a busca"
                        IsVisible="{Binding Buscando}" Command="{Binding LimparBuscaCommand}" />
              </TextBox.InnerRightContent>
            </TextBox>
          </Grid>
        </Border>

        <!-- o clique direito já seleciona a linha: o menu age sobre o commit selecionado -->
        <ListBox Grid.Row="1" x:Name="ListaDeCommits" ItemsSource="{Binding Commits}"
                 SelectedItem="{Binding SelectedCommit}">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Copiar hash" Click="CopiarHash_Click">
                <MenuItem.Icon><TextBlock Classes="glifo cinza" Text="{x:Static controls:Glifos.Copiar}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Comparar com a branch atual..." Command="{Binding CompararComAtualCommand}">
                <MenuItem.Icon><TextBlock Classes="glifo azul" Text="{x:Static controls:Glifos.Comparar}" /></MenuItem.Icon>
              </MenuItem>
              <Separator />
              <MenuItem Header="Criar branch aqui..." Command="{Binding CriarBranchAquiCommand}">
                <MenuItem.Icon><TextBlock Classes="glifo verde" Text="{x:Static controls:Glifos.Branch}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Criar tag aqui..." Command="{Binding CriarTagAquiCommand}">
                <MenuItem.Icon><TextBlock Classes="glifo amarelo" Text="{x:Static controls:Glifos.Tag}" /></MenuItem.Icon>
              </MenuItem>
              <Separator />
              <MenuItem Header="Cherry-pick na branch atual" Command="{Binding CherryPickCommand}">
                <MenuItem.Icon><TextBlock Classes="glifo roxo" Text="{x:Static controls:Glifos.CherryPick}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Reverter este commit" Command="{Binding ReverterCommitCommand}">
                <MenuItem.Icon><TextBlock Classes="glifo laranja" Text="{x:Static controls:Glifos.Reverter}" /></MenuItem.Icon>
              </MenuItem>
              <MenuItem Header="Reorganizar commits daqui até o HEAD..." Command="{Binding ReorganizarCommand}">
                <MenuItem.Icon><TextBlock Classes="glifo roxo" Text="{x:Static controls:Glifos.Reorganizar}" /></MenuItem.Icon>
              </MenuItem>
              <Separator />
              <MenuItem Header="Resetar branch atual para cá">
                <MenuItem.Icon><TextBlock Classes="glifo vermelho" Text="{x:Static controls:Glifos.Resetar}" /></MenuItem.Icon>
                <MenuItem Header="Soft: mantém as alterações preparadas" Command="{Binding ResetSoftCommand}">
                  <MenuItem.Icon><TextBlock Classes="glifo amarelo" Text="{x:Static controls:Glifos.Resetar}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Mixed: mantém as alterações como locais" Command="{Binding ResetMixedCommand}">
                  <MenuItem.Icon><TextBlock Classes="glifo laranja" Text="{x:Static controls:Glifos.Resetar}" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Hard: descarta tudo" Command="{Binding ResetHardCommand}">
                  <MenuItem.Icon><TextBlock Classes="glifo vermelho" Text="{x:Static controls:Glifos.Resetar}" /></MenuItem.Icon>
                </MenuItem>
              </MenuItem>
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:CommitRowViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" Height="26" ToolTip.Tip="{Binding Subject}">
                <controls:GraphCell Grid.Column="0" Row="{Binding Row}" Height="26"
                                    Width="{Binding GraphWidth}" LaneStep="{Binding LaneStep}"
                                    NodeBorderBrush="{DynamicResource BgPanel}" />
                <!-- grade, não StackPanel: em pilha o texto ganha espaço infinito,
                     nunca trunca e passa por cima da coluna do hash -->
                <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ClipToBounds="True">
                  <ItemsControl Grid.Column="0" ItemsSource="{Binding Refs}" MaxWidth="230"
                                ClipToBounds="True" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:RefChipViewModel">
                        <Border Classes="chip" ToolTip.Tip="{Binding Tooltip}"
                                BorderBrush="{Binding Color, Converter={x:Static local:Converters.ResourceBrush}}">
                          <TextBlock Text="{Binding Text}" FontSize="10" MaxWidth="150"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{Binding Color, Converter={x:Static local:Converters.ResourceBrush}}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Grid.Column="1" Text="{Binding Subject}" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" />
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding ShortDate}" Classes="faint" FontSize="11"
                           VerticalAlignment="Center" Margin="8,0,10,0" MinWidth="42"
                           TextAlignment="Right" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

    <!-- conteúdo do commit selecionado -->
    <Grid Grid.Column="2">
      <TextBlock Text="Selecione um commit para ver os detalhes." Classes="faint"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsVisible="{Binding !HasDetail}" />

      <Grid IsVisible="{Binding HasDetail}" RowDefinitions="Auto,*">

        <!-- cabeçalho do commit -->
        <Border Grid.Row="0" Background="{DynamicResource BgPanel}" Padding="12,8"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
          <StackPanel Spacing="3">
            <TextBlock Text="{Binding DetailSubject}" FontWeight="SemiBold" FontSize="13"
                       TextWrapping="Wrap" TextTrimming="None" />
            <WrapPanel>
              <TextBlock Text="{Binding DetailAuthor}" Classes="faint" FontSize="11.5" MaxWidth="320" Margin="0,0,12,0" />
              <TextBlock Text="{Binding DetailDate}" Classes="faint" FontSize="11.5" Margin="0,0,12,0" />
              <TextBlock Text="{Binding DetailHash}" Classes="mono faint" FontSize="11.5" Margin="0,0,12,0" />
              <TextBlock Text="{Binding DetailParentsText}" Classes="mono faint" FontSize="11.5" />
            </WrapPanel>

            <!-- refs completas ficam aqui; a lista mostra só a principal -->
            <ItemsControl ItemsSource="{Binding DetailRefs}" IsVisible="{Binding HasRefs}" Margin="0,3,0,0">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:RefChipViewModel">
                  <Border Classes="chip" Margin="0,2,5,0"
                          BorderBrush="{Binding Color, Converter={x:Static local:Converters.ResourceBrush}}">
                    <TextBlock Text="{Binding Text}" FontSize="10"
                               Foreground="{Binding Color, Converter={x:Static local:Converters.ResourceBrush}}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- o corpo da mensagem: como foi escrito, ou renderizado como Markdown. Nos dois
                 dá para selecionar com o mouse; os botões abaixo copiam a mensagem inteira -->
            <ScrollViewer MaxHeight="110" Margin="0,4,0,0" IsVisible="{Binding CorpoComoTexto}">
              <SelectableTextBlock Text="{Binding DetailBody}" Classes="dim" FontSize="12"
                                   TextWrapping="Wrap" TextTrimming="None" />
            </ScrollViewer>
            <ScrollViewer MaxHeight="190" Margin="0,4,0,0" IsVisible="{Binding CorpoComoMarkdown}">
              <views:MarkdownView Markdown="{Binding DetailBody}" />
            </ScrollViewer>

            <!-- as mesmas ações do clique direito na lista, para quem não sabe que ele existe.
                 Uma linha separa a barra da mensagem, e as ações são pílulas: precisam se
                 destacar do texto do commit logo acima -->
            <Border Height="1" Margin="0,10,0,8" Background="{DynamicResource BorderSoft}" />
            <WrapPanel IsEnabled="{Binding !Busy}">
              <Button Classes="pilula" Margin="0,0,6,6" Click="CopiarHash_Click">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Copiar}" />
                  <TextBlock Text="Copiar hash" />
                </StackPanel>
              </Button>
              <Button Classes="pilula" Margin="0,0,6,6"
                      Classes.destacado="{Binding CorpoEmMarkdown}" Command="{Binding AlternarMarkdownCommand}"
                      ToolTip.Tip="Mostrar a mensagem renderizada como Markdown, ou como foi escrita">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Markdown}" />
                  <TextBlock Text="Markdown" />
                </StackPanel>
              </Button>
              <Button Classes="pilula" Margin="0,0,6,6" Click="CopiarTexto_Click"
                      ToolTip.Tip="Copia a mensagem como foi escrita, com os sinais do Markdown">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Copiar}" />
                  <TextBlock Text="Copiar texto" />
                </StackPanel>
              </Button>
              <Button Classes="pilula" Margin="0,0,6,6" Click="CopiarFormatado_Click"
                      ToolTip.Tip="Copia a mensagem renderizada: cola com título, lista e link no e-mail, no Word ou no Teams">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Copiar}" />
                  <TextBlock Text="Copiar formatado" />
                </StackPanel>
              </Button>
              <Button Classes="pilula verde" Margin="0,0,6,6" Command="{Binding CriarBranchAquiCommand}">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Branch}" />
                  <TextBlock Text="Criar branch aqui" />
                </StackPanel>
              </Button>
              <Button Classes="pilula amarelo" Margin="0,0,6,6" Command="{Binding CriarTagAquiCommand}">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Tag}" />
                  <TextBlock Text="Criar tag" />
                </StackPanel>
              </Button>
              <Button Classes="pilula roxo" Margin="0,0,6,6"
                      ToolTip.Tip="Aplica este commit na branch atual"
                      Command="{Binding CherryPickCommand}">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.CherryPick}" />
                  <TextBlock Text="Cherry-pick" />
                </StackPanel>
              </Button>
              <Button Classes="pilula laranja" Margin="0,0,6,6"
                      ToolTip.Tip="Cria um commit que desfaz este, sem reescrever o histórico"
                      Command="{Binding ReverterCommitCommand}">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Reverter}" />
                  <TextBlock Text="Reverter commit" />
                </StackPanel>
              </Button>
              <Button Classes="pilula roxo" Margin="0,0,6,6"
                      ToolTip.Tip="Rebase interativo: juntar, renomear, apagar ou reordenar os commits daqui até o HEAD"
                      Command="{Binding ReorganizarCommand}">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Reorganizar}" />
                  <TextBlock Text="Reorganizar daqui..." />
                </StackPanel>
              </Button>
              <Button Classes="pilula vermelho" Margin="0,0,6,6"
                      ToolTip.Tip="Move a branch atual para este commit">
                <StackPanel Classes="comIcone">
                  <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Resetar}" />
                  <TextBlock Text="Resetar para cá ▾" />
                </StackPanel>
                <Button.Flyout>
                  <MenuFlyout Placement="BottomEdgeAlignedLeft">
                    <MenuItem Header="Soft: mantém as alterações preparadas" Command="{Binding ResetSoftCommand}">
                      <MenuItem.Icon><TextBlock Classes="glifo amarelo" Text="{x:Static controls:Glifos.Resetar}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Mixed: mantém as alterações como locais" Command="{Binding ResetMixedCommand}">
                      <MenuItem.Icon><TextBlock Classes="glifo laranja" Text="{x:Static controls:Glifos.Resetar}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Hard: descarta tudo" Command="{Binding ResetHardCommand}">
                      <MenuItem.Icon><TextBlock Classes="glifo vermelho" Text="{x:Static controls:Glifos.Resetar}" /></MenuItem.Icon>
                    </MenuItem>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- arquivos do commit + diff, no mesmo desenho da aba Alterações -->
        <Grid Grid.Row="1" x:Name="ArquivosEDiff">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" MinWidth="170" />
            <ColumnDefinition Width="4" />
            <ColumnDefinition Width="*" MinWidth="320" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Classes="panel" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*">
              <Border Grid.Row="0" Padding="10,7" BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="sectionTitle" Text="ARQUIVOS" />
                  <TextBlock Classes="faint" FontSize="10" VerticalAlignment="Center"
                             Text="{Binding Files.Count}" />
                </StackPanel>
              </Border>
              <ListBox Grid.Row="1" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}">
                <ListBox.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Histórico do arquivo" Command="{Binding HistoricoDoArquivoCommand}">
                      <MenuItem.Icon><TextBlock Classes="glifo azul" Text="{x:Static controls:Glifos.Historico}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Autoria das linhas (blame)" Command="{Binding AutoriaDoArquivoCommand}">
                      <MenuItem.Icon><TextBlock Classes="glifo azul" Text="{x:Static controls:Glifos.Autoria}" /></MenuItem.Icon>
                    </MenuItem>
                    <MenuItem Header="Abrir no diff externo" Command="{Binding AbrirNoDiffExternoCommand}">
                      <MenuItem.Icon><TextBlock Classes="glifo azul" Text="{x:Static controls:Glifos.Abrir}" /></MenuItem.Icon>
                    </MenuItem>
                  </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="vm:CommitFileViewModel">
                    <Grid ColumnDefinitions="18,*,Auto" Height="26" ToolTip.Tip="{Binding Path}">
                      <TextBlock Grid.Column="0" Text="{Binding Status}" FontFamily="{DynamicResource MonoFont}"
                                 FontWeight="Bold" FontSize="11" TextAlignment="Center" VerticalAlignment="Center"
                                 Foreground="{Binding StatusColor, Converter={x:Static local:Converters.ResourceBrush}}" />
                      <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="12" Margin="6,0"
                                 VerticalAlignment="Center" />
                      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0"
                                  VerticalAlignment="Center">
                        <TextBlock Text="{Binding AddedText}" FontSize="10.5" Classes="mono"
                                   Foreground="{DynamicResource Green}" />
                        <TextBlock Text="{Binding RemovedText}" FontSize="10.5" Classes="mono"
                                   Foreground="{DynamicResource Red}" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" />

          <views:DiffView Grid.Column="2" DataContext="{Binding Diff}" />
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
