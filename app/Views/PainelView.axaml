<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GRepos.ViewModels"
             xmlns:local="using:GRepos"
             xmlns:controls="using:GRepos.Controls"
             x:Class="GRepos.Views.PainelView"
             x:DataType="vm:PainelViewModel">

  <Grid RowDefinitions="Auto,*" Margin="16,14,16,10">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
      <StackPanel Grid.Column="0">
        <TextBlock Text="{Binding Titulo}" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Subtitulo}" Classes="faint" FontSize="11.5" />
      </StackPanel>
      <!-- a mesma operação em todos os repositórios deste painel -->
      <Button Grid.Column="2" Classes="tiny" BorderThickness="1" BorderBrush="{DynamicResource Border}"
              Content="Em lote…" VerticalAlignment="Center" Margin="8,0,0,0"
              IsVisible="{Binding PodeLote}" Command="{Binding EmLoteCommand}"
              ToolTip.Tip="Obter, puxar, enviar ou trocar de branch em todos os repositórios deste painel" />
      <!-- discreto: só o ícone, como o de atualizar da sidebar -->
      <Button Grid.Column="1" Classes="icon" Content="&#xE72C;" Width="26" Height="24"
              FontSize="12" VerticalAlignment="Center"
              Command="{Binding AtualizarCommand}"
              ToolTip.Tip="Atualizar status e esteiras de todos os repositórios" />
    </Grid>

    <TextBlock Grid.Row="1" Classes="faint" TextWrapping="Wrap" MaxWidth="420"
               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
               IsVisible="{Binding Vazio}"
               Text="Nenhum repositório neste grupo. Use o ⚙ de um repositório para movê-lo para cá." />

    <!-- os cartões reencaixam sozinhos conforme a janela muda de tamanho -->
    <ScrollViewer Grid.Row="1" IsVisible="{Binding !Vazio}">
     <StackPanel>

      <!-- perfil: só no painel geral. Enxuto de propósito — uma linha de identificação
           e uma de números, sem molduras internas -->
      <Border Classes="card" Margin="0,0,0,12" Padding="14,10" IsVisible="{Binding TemPerfil}">
       <DockPanel DataContext="{Binding Perfil}">

        <!-- foto redonda da conta; até ela chegar, a inicial no mesmo lugar -->
        <Panel DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Top">
          <Border CornerRadius="18" Background="{DynamicResource BgActive}" IsVisible="{Binding SemFoto}">
            <TextBlock Text="{Binding Inicial}" FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Accent}" />
          </Border>
          <Border CornerRadius="18" ClipToBounds="True" IsVisible="{Binding TemFoto}">
            <Image Source="{Binding Foto}" Stretch="UniformToFill" />
          </Border>
        </Panel>

        <!-- o quadriculado do GitHub (EV05) à direita; mostra as semanas que cabem,
             sempre até hoje, e some em janela estreita -->
        <controls:GradeContribuicoes DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                     Dias="{Binding Dias}" ReservaEsquerda="390"
                                     IsVisible="{Binding TemContribuicoes}" />

        <StackPanel Spacing="5" VerticalAlignment="Center">

          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <TextBlock Grid.Column="0" Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="13"
                       Foreground="{DynamicResource Accent}" Classes="mono"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Nome}" Classes="faint" FontSize="11.5"
                       Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Text="{Binding Local}" Classes="faint" FontSize="11"
                       VerticalAlignment="Center" IsVisible="{Binding TemLocal}" />
            <!-- com mais de uma conta, as outras ficam aqui para trocar o perfil mostrado -->
            <ItemsControl Grid.Column="3" ItemsSource="{Binding OutrasContas}" Margin="12,0,0,0"
                          VerticalAlignment="Center" IsVisible="{Binding TemOutrasContas}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="tiny" BorderThickness="1" BorderBrush="{DynamicResource Border}"
                          Content="{Binding}" FontSize="10.5"
                          ToolTip.Tip="Mostrar o perfil desta conta"
                          Command="{Binding $parent[ItemsControl].DataContext.TrocarContaCommand}"
                          CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>

          <TextBlock Text="{Binding Erro}" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource Red}" IsVisible="{Binding TemErro}" />

          <!-- números em linha, no tamanho do texto: destaque só na cor -->
          <WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,16,0">
              <TextBlock Text="{Binding Repositorios}" FontSize="12.5" FontWeight="SemiBold" />
              <TextBlock Text="repos" Classes="faint" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,16,0">
              <TextBlock Text="{Binding Estrelas}" FontSize="12.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource Yellow}" />
              <TextBlock Text="estrelas" Classes="faint" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,16,0">
              <TextBlock Text="{Binding Seguidores}" FontSize="12.5" FontWeight="SemiBold" />
              <TextBlock Text="seguidores" Classes="faint" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,16,0">
              <TextBlock Text="{Binding ReposLocais}" FontSize="12.5" FontWeight="SemiBold" />
              <TextBlock Text="aqui" Classes="faint" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,16,0">
              <TextBlock Text="{Binding LinhasTexto}" FontSize="12.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource Green}" />
              <TextBlock Text="linhas" Classes="faint" FontSize="11" VerticalAlignment="Center" />
              <Button Classes="tiny" Content="contar" VerticalAlignment="Center" Padding="5,0"
                      IsVisible="{Binding !LinhasContadas}" IsEnabled="{Binding !ContandoLinhas}"
                      Command="{Binding ContarLinhasCommand}"
                      ToolTip.Tip="Soma as linhas dos seus commits em cada repositório local, sem repetir o histórico do par Origem × Destino" />
              <TextBlock Text="{Binding LinhasDetalhe}" Classes="faint" FontSize="10"
                         VerticalAlignment="Center" IsVisible="{Binding LinhasContadas}" />
              <!-- a contagem fica guardada; recontar é pedir de novo, quando quiser -->
              <Button Classes="icon" Content="&#xE72C;" Width="18" Height="18" FontSize="9"
                      VerticalAlignment="Center" Padding="0"
                      IsVisible="{Binding PodeRecontar}" Command="{Binding ContarLinhasCommand}"
                      ToolTip.Tip="Contar de novo as linhas dos seus commits" />
              <TextBlock Text="{Binding ProgressoLinhas}" Classes="faint" FontSize="10"
                         VerticalAlignment="Center" IsVisible="{Binding ContandoLinhas}" />
            </StackPanel>
          </WrapPanel>

          <!-- terceira linha: o ano de contribuições com a legenda, e as linguagens -->
          <WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,0,16,0"
                        IsVisible="{Binding TemContribuicoes}">
              <TextBlock Text="{Binding ContribuicoesTexto}" Classes="faint" FontSize="10.5"
                         VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="menos" Classes="faint" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,2,0" />
              <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource BgActive}" VerticalAlignment="Center" />
              <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource Green}" Opacity="0.35" VerticalAlignment="Center" />
              <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource Green}" Opacity="0.55" VerticalAlignment="Center" />
              <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource Green}" Opacity="0.78" VerticalAlignment="Center" />
              <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource Green}" VerticalAlignment="Center" />
              <TextBlock Text="mais" Classes="faint" FontSize="9.5" VerticalAlignment="Center" Margin="2,0,0,0" />
            </StackPanel>
            <TextBlock Text="{Binding Linguagens}" Classes="faint" FontSize="10.5"
                       VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" />
          </WrapPanel>
        </StackPanel>
       </DockPanel>
      </Border>

      <!-- uma seção por grupo; no painel de um grupo só o título fica escondido -->
      <ItemsControl ItemsSource="{Binding Secoes}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:SecaoPainelViewModel">
            <StackPanel Margin="0,0,0,10">

              <!-- título do grupo: clicar recolhe a seção, como o grupo na árvore -->
              <Button Classes="secaoTopo" Margin="0,0,0,6" Command="{Binding AlternarCommand}"
                      IsVisible="{Binding MostraTitulo}" HorizontalAlignment="Left"
                      ToolTip.Tip="Recolher ou abrir o grupo (vale também para a árvore)">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <TextBlock Text="{Binding Chevron}" FontSize="8" Classes="faint" Width="10"
                             FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets,Segoe UI Symbol"
                             VerticalAlignment="Center" />
                  <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                           Fill="{Binding Cor, Converter={x:Static local:Converters.StringToBrush}}" />
                  <TextBlock Text="{Binding Titulo}" FontSize="11.5" FontWeight="SemiBold"
                             VerticalAlignment="Center"
                             Foreground="{Binding Cor, Converter={x:Static local:Converters.StringToBrush}}" />
                  <TextBlock Text="{Binding Contagem}" Classes="faint" FontSize="10.5"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Pendencias}" FontSize="10.5" Margin="6,0,0,0"
                             Foreground="{DynamicResource Yellow}" VerticalAlignment="Center"
                             IsVisible="{Binding MostraPendencias}" />
                </StackPanel>
              </Button>

              <ItemsControl ItemsSource="{Binding Cartoes}" Classes="cartoes"
                            IsVisible="{Binding MostraCartoes}">
                <!-- o cartão aberto ocupa a fileira sozinho. A marca vai no contêiner, que
                     é o filho que a grade enxerga; o ">" do Avalonia segue o pai lógico, que
                     é este ItemsControl, e a classe evita pegar as listas de dentro do cartão
                     -->
                <ItemsControl.Styles>
                  <Style Selector="ItemsControl.cartoes > ContentPresenter">
                    <Setter Property="controls:GradeCartoes.LinhaInteira" Value="{Binding Expandido}" />
                  </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <controls:GradeCartoes LarguraMinima="250" Espaco="10" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:CartaoRepoViewModel">
            <!-- moldura do cartão. O topo é o botão que abre e fecha; o conteúdo aberto
                 fica fora dele, senão clicar num passo da esteira fecharia o cartão -->
            <Panel Classes="cartaoMoldura">
            <Border Classes="cartaoFundo">
              <Grid ColumnDefinitions="3,*">
                <Border Grid.Column="0"
                        Background="{Binding CorDoGrupo, Converter={x:Static local:Converters.StringToBrush}}" />

               <StackPanel Grid.Column="1">
                <Button Classes="cartaoTopo" Command="{Binding AlternarCommand}"
                        ToolTip.Tip="{Binding Tooltip}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                <StackPanel Margin="11,9,11,9" Spacing="3" MinHeight="40">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Nome}" FontWeight="SemiBold"
                               FontSize="12.5" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7"
                                VerticalAlignment="Center">
                      <TextBlock Text="{Binding AheadTexto}" FontSize="11" IsVisible="{Binding MostraAhead}"
                                 Foreground="{DynamicResource Green}" />
                      <TextBlock Text="{Binding BehindTexto}" FontSize="11" IsVisible="{Binding MostraBehind}"
                                 Foreground="{DynamicResource Orange}" />
                      <TextBlock Text="{Binding ConflitoTexto}" FontSize="11" IsVisible="{Binding MostraConflito}"
                                 Foreground="{DynamicResource Red}" />
                      <TextBlock Text="{Binding SujoTexto}" FontSize="11" IsVisible="{Binding MostraSujo}"
                                 Foreground="{DynamicResource Yellow}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Seta}" FontSize="9" Classes="faint"
                               Margin="8,0,0,0" VerticalAlignment="Center"
                               FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets,Segoe UI Symbol" />
                  </Grid>

                  <!-- segunda linha: branch, esteira e PRs, tudo como texto corrido -->
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="{Binding Branch}" Classes="faint" FontSize="10.5"
                               MaxWidth="120" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="·" Classes="faint" FontSize="10.5" IsVisible="{Binding !ConsultandoCi}" />
                    <TextBlock Text="{Binding CiSimbolo}" FontSize="10.5" IsVisible="{Binding TemCi}"
                               Foreground="{Binding CiCor, Converter={x:Static local:Converters.ResourceBrush}}" />
                    <TextBlock Text="{Binding CiTexto}" Classes="faint" FontSize="10.5"
                               IsVisible="{Binding !ConsultandoCi}" />
                    <TextBlock Text="{Binding PrTexto}" FontSize="10.5" IsVisible="{Binding TemPrs}"
                               Foreground="{DynamicResource Purple}" />
                    <TextBlock Text="indisponível" FontSize="10.5" IsVisible="{Binding TemErro}"
                               Foreground="{DynamicResource Red}" />
                  </StackPanel>
                </StackPanel>
                </Button>

                <!-- ============================================== cartão aberto -->
                <Border IsVisible="{Binding Expandido}" Padding="11,8,11,10"
                        BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0">
                  <StackPanel Spacing="8">

                    <TextBlock Text="Consultando a esteira…" Classes="faint" FontSize="11.5"
                               IsVisible="{Binding MostraConsultando}" />
                    <TextBlock Text="Este repositório não tem esteira (GitHub Actions)." Classes="faint"
                               FontSize="11.5" IsVisible="{Binding MostraSemEsteira}" />

                    <!-- a última execução da branch, com o passo a passo de cada job.
                         A visibilidade vem do cartão, antes de o DataContext virar a esteira -->
                    <Panel IsVisible="{Binding MostraEsteira}">
                    <StackPanel Spacing="8" DataContext="{Binding Esteira}">
                      <TextBlock Text="{Binding Erro}" FontSize="11.5" TextWrapping="Wrap"
                                 Foreground="{DynamicResource Red}" IsVisible="{Binding TemErro}" />
                      <TextBlock Text="Carregando…" Classes="faint" FontSize="11.5"
                                 IsVisible="{Binding Carregando}" />
                      <TextBlock Text="Nenhuma execução nesta branch." Classes="faint" FontSize="11.5"
                                 IsVisible="{Binding SemExecucoes}" />

                      <ItemsControl ItemsSource="{Binding Execucoes}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:CiExecucaoViewModel">
                            <Grid ColumnDefinitions="16,*,Auto" ToolTip.Tip="{Binding Tooltip}">
                              <TextBlock Grid.Column="0" Text="{Binding Simbolo}" FontSize="13"
                                         VerticalAlignment="Top"
                                         Foreground="{Binding Cor, Converter={x:Static local:Converters.ResourceBrush}}" />
                              <StackPanel Grid.Column="1" Margin="6,0">
                                <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                                  <Run Text="{Binding Workflow}" FontWeight="SemiBold" />
                                  <Run Text=" — " />
                                  <Run Text="{Binding Titulo}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Rodape}" Classes="faint" FontSize="10.5"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <TextBlock Grid.Column="2" Text="{Binding Numero}" Classes="faint"
                                         FontSize="10.5" VerticalAlignment="Top" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock Text="Carregando os passos…" Classes="faint" FontSize="11.5"
                                 IsVisible="{Binding CarregandoJobs}" />

                      <ItemsControl ItemsSource="{Binding Jobs}" Margin="22,0,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:CiJobViewModel">
                            <StackPanel Margin="0,0,0,8">
                              <Grid ColumnDefinitions="16,*,Auto" Margin="0,0,0,2">
                                <TextBlock Grid.Column="0" Text="{Binding Simbolo}" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Cor, Converter={x:Static local:Converters.ResourceBrush}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Nome}" FontWeight="SemiBold"
                                           FontSize="11.5" Margin="6,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding DuracaoTexto}" Classes="faint"
                                           FontSize="10.5" VerticalAlignment="Center" />
                              </Grid>
                              <ItemsControl ItemsSource="{Binding Etapas}" Margin="22,0,0,0">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="vm:CiEtapaViewModel">
                                    <Grid ColumnDefinitions="14,*,Auto" Height="20">
                                      <TextBlock Grid.Column="0" Text="{Binding Simbolo}" FontSize="10.5"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding Cor, Converter={x:Static local:Converters.ResourceBrush}}" />
                                      <TextBlock Grid.Column="1" Text="{Binding Nome}" FontSize="11"
                                                 Margin="6,0" VerticalAlignment="Center"
                                                 TextTrimming="CharacterEllipsis"
                                                 FontWeight="{Binding Peso}" />
                                      <TextBlock Grid.Column="2" Text="{Binding DuracaoTexto}" Classes="faint"
                                                 FontSize="10" VerticalAlignment="Center" />
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- ações da esteira: todas confirmam antes, como na janela -->
                      <WrapPanel>
                        <ComboBox MinWidth="140" Height="24" MinHeight="0" FontSize="11" Padding="8,0"
                                  Margin="0,0,6,4" ItemsSource="{Binding Workflows}"
                                  SelectedItem="{Binding WorkflowEscolhido}" VerticalAlignment="Center"
                                  ToolTip.Tip="Workflow que o Executar dispara, nesta branch">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Nome}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="Executar" Classes="tiny" BorderThickness="1" Margin="0,0,6,4"
                                BorderBrush="{DynamicResource Border}" IsEnabled="{Binding PodeDisparar}"
                                Command="{Binding DispararCommand}"
                                ToolTip.Tip="Dispara o workflow escolhido nesta branch" />
                        <Button Content="Reexecutar" Classes="tiny" BorderThickness="1" Margin="0,0,6,4"
                                BorderBrush="{DynamicResource Border}" IsEnabled="{Binding PodeReexecutar}"
                                Command="{Binding ReexecutarCommand}"
                                ToolTip.Tip="Roda de novo esta execução" />
                        <Button Content="Só as falhas" Classes="tiny" BorderThickness="1" Margin="0,0,6,4"
                                BorderBrush="{DynamicResource Border}" IsEnabled="{Binding PodeReexecutarFalhas}"
                                Command="{Binding ReexecutarFalhasCommand}"
                                ToolTip.Tip="Roda de novo apenas os jobs que falharam" />
                        <Button Content="Parar" Classes="tiny danger" BorderThickness="1" Margin="0,0,6,4"
                                BorderBrush="{DynamicResource Border}" IsEnabled="{Binding PodeCancelar}"
                                Command="{Binding CancelarCommand}"
                                ToolTip.Tip="Cancela a execução, que ainda está rodando" />
                        <TextBlock Text="{Binding RitmoTexto}" Classes="faint" FontSize="10.5"
                                   VerticalAlignment="Center" Margin="4,0,0,4" />
                      </WrapPanel>
                    </StackPanel>
                    </Panel>

                    <!-- ações do repositório, valem com ou sem esteira -->
                    <WrapPanel>
                      <Button Content="Abrir repositório" Classes="tiny" BorderThickness="1" Margin="0,0,6,0"
                              BorderBrush="{DynamicResource Border}" Command="{Binding AbrirCommand}"
                              ToolTip.Tip="Abre as abas de alterações e histórico deste repositório" />
                      <Button Content="Ver todas as execuções" Classes="tiny" BorderThickness="1" Margin="0,0,6,0"
                              BorderBrush="{DynamicResource Border}" IsVisible="{Binding TemCi}"
                              Command="{Binding AbrirEsteiraCommand}"
                              ToolTip.Tip="Abre a janela da esteira, com o histórico e os filtros" />
                      <Button Content="Pull requests" Classes="tiny" BorderThickness="1" Margin="0,0,6,0"
                              BorderBrush="{DynamicResource Border}" IsVisible="{Binding TemGitHub}"
                              Command="{Binding AbrirPrsCommand}"
                              ToolTip.Tip="Ver os pull requests, criar o da branch atual e mesclar" />
                      <Button Content="Pasta" Classes="tiny" BorderThickness="1" Margin="0,0,6,0"
                              BorderBrush="{DynamicResource Border}" Command="{Binding AbrirPastaCommand}"
                              ToolTip.Tip="Abre a pasta do repositório no Explorer" />
                      <Button Content="Terminal" Classes="tiny" BorderThickness="1" Margin="0,0,6,0"
                              BorderBrush="{DynamicResource Border}" Command="{Binding AbrirTerminalCommand}"
                              ToolTip.Tip="Abre o Git Bash na pasta do repositório" />
                    </WrapPanel>
                  </StackPanel>
                </Border>
               </StackPanel>
              </Grid>
            </Border>
            <!-- contorno por cima de tudo: faixa do grupo e fundo do topo (no hover) ficam
                 por baixo dele, e a linha não aparece mais cortada nos cantos -->
            <Border Classes="cartaoContorno" IsHitTestVisible="False" />
            </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
