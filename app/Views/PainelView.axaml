<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GRepos.ViewModels"
             xmlns:local="using:GRepos"
             xmlns:controls="using:GRepos.Controls"
             x:Class="GRepos.Views.PainelView"
             x:DataType="vm:PainelViewModel">

  <Grid RowDefinitions="Auto,*" Margin="16,14,16,10">

    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
      <StackPanel Grid.Column="0">
        <TextBlock Text="{Binding Titulo}" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Subtitulo}" Classes="faint" FontSize="11.5" />
      </StackPanel>
      <!-- a mesma operação em todos os repositórios deste painel -->
      <Button Grid.Column="2" Classes="tiny roxo" BorderThickness="1" BorderBrush="{DynamicResource Border}" VerticalAlignment="Center" Margin="8,0,0,0"
              IsVisible="{Binding PodeLote}" Command="{Binding EmLoteCommand}"
              ToolTip.Tip="Obter, puxar, enviar ou trocar de branch em todos os repositórios deste painel">
        <StackPanel Classes="comIcone">
          <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Lote}" />
          <TextBlock Text="Em lote…" />
        </StackPanel>
      </Button>
      <!-- discreto: só o ícone, como o de atualizar da sidebar -->
      <Button Grid.Column="1" Classes="icon" Content="&#xE72C;" Width="26" Height="24"
              FontSize="12" VerticalAlignment="Center"
              Command="{Binding AtualizarCommand}"
              ToolTip.Tip="Atualizar status e esteiras de todos os repositórios" />
    </Grid>

    <TextBlock Grid.Row="1" Classes="faint" TextWrapping="Wrap" MaxWidth="420"
               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
               IsVisible="{Binding Vazio}"
               Text="Nenhum repositório neste grupo. Use o ⚙ de um repositório para movê-lo para cá." />

    <!-- os cartões reencaixam sozinhos conforme a janela muda de tamanho -->
    <ScrollViewer Grid.Row="1" IsVisible="{Binding !Vazio}">
     <StackPanel>

      <!-- perfil: só no painel geral. Enxuto de propósito — uma linha de identificação
           e uma de números, sem molduras internas -->
      <Border Classes="card" Margin="0,0,0,12" Padding="14,10" IsVisible="{Binding TemPerfil}">
       <!-- clique direito: a cor de destaque dos quadros, como o color do github-cool-readme -->
       <Border.ContextMenu>
         <ContextMenu>
           <MenuItem Header="Cor de destaque dos quadros">
             <MenuItem.Icon><TextBlock Classes="glifo cinza" Text="{x:Static controls:Glifos.Cor}" /></MenuItem.Icon>
             <MenuItem ToggleType="Radio" GroupName="corDosQuadros"
                       IsChecked="{Binding Perfil.CorDosQuadros, Mode=OneWay, Converter={x:Static local:Converters.Igual}, ConverterParameter=github}"
                       Command="{Binding Perfil.EscolherCorCommand}" CommandParameter="github">
               <MenuItem.Header>
                 <StackPanel Orientation="Horizontal" Spacing="4">
                   <Ellipse Width="9" Height="9" Fill="{DynamicResource Green}" VerticalAlignment="Center" />
                   <Ellipse Width="9" Height="9" Fill="{DynamicResource Lane0}" VerticalAlignment="Center" Margin="0,0,4,0" />
                   <TextBlock Text="GitHub (verde e azul)" VerticalAlignment="Center" />
                 </StackPanel>
               </MenuItem.Header>
             </MenuItem>
             <MenuItem ToggleType="Radio" GroupName="corDosQuadros"
                       IsChecked="{Binding Perfil.CorDosQuadros, Mode=OneWay, Converter={x:Static local:Converters.Igual}, ConverterParameter=ambar}"
                       Command="{Binding Perfil.EscolherCorCommand}" CommandParameter="ambar">
               <MenuItem.Header>
                 <StackPanel Orientation="Horizontal" Spacing="8">
                   <Ellipse Width="9" Height="9" Fill="{DynamicResource Yellow}" VerticalAlignment="Center" />
                   <TextBlock Text="Âmbar" VerticalAlignment="Center" />
                 </StackPanel>
               </MenuItem.Header>
             </MenuItem>
             <MenuItem ToggleType="Radio" GroupName="corDosQuadros"
                       IsChecked="{Binding Perfil.CorDosQuadros, Mode=OneWay, Converter={x:Static local:Converters.Igual}, ConverterParameter=verde}"
                       Command="{Binding Perfil.EscolherCorCommand}" CommandParameter="verde">
               <MenuItem.Header>
                 <StackPanel Orientation="Horizontal" Spacing="8">
                   <Ellipse Width="9" Height="9" Fill="{DynamicResource Green}" VerticalAlignment="Center" />
                   <TextBlock Text="Verde" VerticalAlignment="Center" />
                 </StackPanel>
               </MenuItem.Header>
             </MenuItem>
             <MenuItem ToggleType="Radio" GroupName="corDosQuadros"
                       IsChecked="{Binding Perfil.CorDosQuadros, Mode=OneWay, Converter={x:Static local:Converters.Igual}, ConverterParameter=roxo}"
                       Command="{Binding Perfil.EscolherCorCommand}" CommandParameter="roxo">
               <MenuItem.Header>
                 <StackPanel Orientation="Horizontal" Spacing="8">
                   <Ellipse Width="9" Height="9" Fill="{DynamicResource Purple}" VerticalAlignment="Center" />
                   <TextBlock Text="Roxo" VerticalAlignment="Center" />
                 </StackPanel>
               </MenuItem.Header>
             </MenuItem>
             <MenuItem ToggleType="Radio" GroupName="corDosQuadros"
                       IsChecked="{Binding Perfil.CorDosQuadros, Mode=OneWay, Converter={x:Static local:Converters.Igual}, ConverterParameter=ciano}"
                       Command="{Binding Perfil.EscolherCorCommand}" CommandParameter="ciano">
               <MenuItem.Header>
                 <StackPanel Orientation="Horizontal" Spacing="8">
                   <Ellipse Width="9" Height="9" Fill="{DynamicResource Lane7}" VerticalAlignment="Center" />
                   <TextBlock Text="Ciano" VerticalAlignment="Center" />
                 </StackPanel>
               </MenuItem.Header>
             </MenuItem>
             <MenuItem ToggleType="Radio" GroupName="corDosQuadros"
                       IsChecked="{Binding Perfil.CorDosQuadros, Mode=OneWay, Converter={x:Static local:Converters.Igual}, ConverterParameter=vermelho}"
                       Command="{Binding Perfil.EscolherCorCommand}" CommandParameter="vermelho">
               <MenuItem.Header>
                 <StackPanel Orientation="Horizontal" Spacing="8">
                   <Ellipse Width="9" Height="9" Fill="{DynamicResource Red}" VerticalAlignment="Center" />
                   <TextBlock Text="Vermelho" VerticalAlignment="Center" />
                 </StackPanel>
               </MenuItem.Header>
             </MenuItem>
             <MenuItem ToggleType="Radio" GroupName="corDosQuadros"
                       IsChecked="{Binding Perfil.CorDosQuadros, Mode=OneWay, Converter={x:Static local:Converters.Igual}, ConverterParameter=azul}"
                       Command="{Binding Perfil.EscolherCorCommand}" CommandParameter="azul">
               <MenuItem.Header>
                 <StackPanel Orientation="Horizontal" Spacing="8">
                   <Ellipse Width="9" Height="9" Fill="{DynamicResource Lane0}" VerticalAlignment="Center" />
                   <TextBlock Text="Azul" VerticalAlignment="Center" />
                 </StackPanel>
               </MenuItem.Header>
             </MenuItem>
           </MenuItem>
           <!-- o desenho dos quadros: o clássico ou os displays retrô do github-cool-readme -->
           <MenuItem Header="Estilo dos quadros">
             <MenuItem.Icon><TextBlock Classes="glifo cinza" Text="{x:Static controls:Glifos.Estilo}" /></MenuItem.Icon>
             <MenuItem Header="Clássico" ToggleType="Radio" GroupName="estiloDosQuadros"
                       IsChecked="{Binding Perfil.EstiloDosQuadros, Mode=OneWay, Converter={x:Static local:Converters.Igual}, ConverterParameter=classico}"
                       Command="{Binding Perfil.EscolherEstiloCommand}" CommandParameter="classico" />
             <MenuItem Header="Retrô: matriz de pontos" ToggleType="Radio" GroupName="estiloDosQuadros"
                       IsChecked="{Binding Perfil.EstiloDosQuadros, Mode=OneWay, Converter={x:Static local:Converters.Igual}, ConverterParameter=pontos}"
                       Command="{Binding Perfil.EscolherEstiloCommand}" CommandParameter="pontos" />
             <MenuItem Header="Retrô: pontos flutuantes" ToggleType="Radio" GroupName="estiloDosQuadros"
                       IsChecked="{Binding Perfil.EstiloDosQuadros, Mode=OneWay, Converter={x:Static local:Converters.Igual}, ConverterParameter=flutuante}"
                       Command="{Binding Perfil.EscolherEstiloCommand}" CommandParameter="flutuante" />
             <MenuItem Header="Retrô: OLED" ToggleType="Radio" GroupName="estiloDosQuadros"
                       IsChecked="{Binding Perfil.EstiloDosQuadros, Mode=OneWay, Converter={x:Static local:Converters.Igual}, ConverterParameter=oled}"
                       Command="{Binding Perfil.EscolherEstiloCommand}" CommandParameter="oled" />
           </MenuItem>
         </ContextMenu>
       </Border.ContextMenu>
       <StackPanel DataContext="{Binding Perfil}">
       <DockPanel>

        <!-- foto redonda da conta; até ela chegar, a inicial no mesmo lugar -->
        <Panel DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Top">
          <Border CornerRadius="18" Background="{DynamicResource BgActive}" IsVisible="{Binding SemFoto}">
            <TextBlock Text="{Binding Inicial}" FontSize="15" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource Accent}" />
          </Border>
          <Border CornerRadius="18" ClipToBounds="True" IsVisible="{Binding TemFoto}">
            <Image Source="{Binding Foto}" Stretch="UniformToFill" />
          </Border>
        </Panel>

        <!-- o quadriculado do GitHub (EV05) à direita; mostra as semanas que cabem,
             sempre até hoje, e some em janela estreita -->
        <controls:GradeContribuicoes DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                                     Dias="{Binding Dias}" ReservaEsquerda="390"
                                     Destaque="{Binding CorDasBarras, Converter={x:Static local:Converters.ResourceBrush}}"
                                     IsVisible="{Binding TemContribuicoes}" />

        <StackPanel Spacing="5" VerticalAlignment="Center">

          <Grid ColumnDefinitions="Auto,*,Auto,Auto">
            <TextBlock Grid.Column="0" Text="{Binding Titulo}" FontWeight="SemiBold" FontSize="13"
                       Foreground="{DynamicResource Accent}" Classes="mono"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Nome}" Classes="faint" FontSize="11.5"
                       Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Grid.Column="2" Text="{Binding Local}" Classes="faint" FontSize="11"
                       VerticalAlignment="Center" IsVisible="{Binding TemLocal}" />
            <!-- com mais de uma conta, as outras ficam aqui para trocar o perfil mostrado -->
            <ItemsControl Grid.Column="3" ItemsSource="{Binding OutrasContas}" Margin="12,0,0,0"
                          VerticalAlignment="Center" IsVisible="{Binding TemOutrasContas}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="4" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="tiny" BorderThickness="1" BorderBrush="{DynamicResource Border}"
                          Content="{Binding}" FontSize="10.5"
                          ToolTip.Tip="Mostrar o perfil desta conta"
                          Command="{Binding $parent[ItemsControl].DataContext.TrocarContaCommand}"
                          CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>

          <TextBlock Text="{Binding Erro}" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource Red}" IsVisible="{Binding TemErro}" />

          <!-- números em linha, no tamanho do texto: destaque só na cor -->
          <WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,16,0">
              <TextBlock Text="{Binding Repositorios}" FontSize="12.5" FontWeight="SemiBold" />
              <TextBlock Text="repos" Classes="faint" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,16,0">
              <TextBlock Text="{Binding Estrelas}" FontSize="12.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource Yellow}" />
              <TextBlock Text="estrelas" Classes="faint" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,16,0">
              <TextBlock Text="{Binding Seguidores}" FontSize="12.5" FontWeight="SemiBold" />
              <TextBlock Text="seguidores" Classes="faint" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,16,0">
              <TextBlock Text="{Binding ReposLocais}" FontSize="12.5" FontWeight="SemiBold" />
              <TextBlock Text="aqui" Classes="faint" FontSize="11" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,0,16,0">
              <TextBlock Text="{Binding LinhasTexto}" FontSize="12.5" FontWeight="SemiBold"
                         Foreground="{DynamicResource Green}" />
              <TextBlock Text="linhas" Classes="faint" FontSize="11" VerticalAlignment="Center" />
              <Button Classes="tiny" Content="contar" VerticalAlignment="Center" Padding="5,0"
                      IsVisible="{Binding !LinhasContadas}" IsEnabled="{Binding !ContandoLinhas}"
                      Command="{Binding ContarLinhasCommand}"
                      ToolTip.Tip="Soma as linhas dos seus commits em cada repositório local, sem repetir o histórico do par Origem × Destino" />
              <TextBlock Text="{Binding LinhasDetalhe}" Classes="faint" FontSize="10"
                         VerticalAlignment="Center" IsVisible="{Binding LinhasContadas}" />
              <!-- a contagem fica guardada; recontar é pedir de novo, quando quiser -->
              <Button Classes="icon" Content="&#xE72C;" Width="18" Height="18" FontSize="9"
                      VerticalAlignment="Center" Padding="0"
                      IsVisible="{Binding PodeRecontar}" Command="{Binding ContarLinhasCommand}"
                      ToolTip.Tip="Contar de novo as linhas dos seus commits" />
              <TextBlock Text="{Binding ProgressoLinhas}" Classes="faint" FontSize="10"
                         VerticalAlignment="Center" IsVisible="{Binding ContandoLinhas}" />
            </StackPanel>
          </WrapPanel>

          <!-- terceira linha: o ano de contribuições com a legenda, e as linguagens -->
          <WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="3" Margin="0,0,16,0"
                        IsVisible="{Binding TemContribuicoes}">
              <TextBlock Text="{Binding ContribuicoesTexto}" Classes="faint" FontSize="10.5"
                         VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="menos" Classes="faint" FontSize="9.5" VerticalAlignment="Center" Margin="0,0,2,0" />
              <Border Width="9" Height="9" CornerRadius="2" Background="{DynamicResource BgActive}" VerticalAlignment="Center" />
              <Border Width="9" Height="9" CornerRadius="2" Opacity="0.35" VerticalAlignment="Center"
                      Background="{Binding CorDasBarras, Converter={x:Static local:Converters.ResourceBrush}}" />
              <Border Width="9" Height="9" CornerRadius="2" Opacity="0.55" VerticalAlignment="Center"
                      Background="{Binding CorDasBarras, Converter={x:Static local:Converters.ResourceBrush}}" />
              <Border Width="9" Height="9" CornerRadius="2" Opacity="0.78" VerticalAlignment="Center"
                      Background="{Binding CorDasBarras, Converter={x:Static local:Converters.ResourceBrush}}" />
              <Border Width="9" Height="9" CornerRadius="2" VerticalAlignment="Center"
                      Background="{Binding CorDasBarras, Converter={x:Static local:Converters.ResourceBrush}}" />
              <TextBlock Text="mais" Classes="faint" FontSize="9.5" VerticalAlignment="Center" Margin="2,0,0,0" />
            </StackPanel>
            <!-- as do GitHub (repositórios públicos) só até a barra das linhas daqui chegar -->
            <TextBlock Text="{Binding Linguagens}" Classes="faint" FontSize="10.5"
                       VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding !TemLinguagensLocais}" />
          </WrapPanel>
        </StackPanel>
       </DockPanel>

       <!-- segunda faixa: os quadros no desenho do github-cool-readme. Resumo, ritmo e
            sequências saem do calendário do GitHub; as linguagens, das linhas dos seus
            commits aqui. Quatro, duas ou uma coluna, conforme a largura -->
       <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSoft}"
               Margin="0,10,0,0" Padding="0,10,0,2" IsVisible="{Binding TemQuadros}">
        <!-- no retrô os quadros pedem mais largura: o display tem 150 pontos de ponta a ponta -->
        <controls:GradeCartoes LarguraMinima="{Binding LarguraDosQuadros}" Espaco="28" SemSobra="True">

         <!-- resumo: os totais do ano e o anel dos dias ativos; com teto, para o número
              não fugir do rótulo quando o quadro ocupa meia largura -->
         <Panel IsVisible="{Binding TemResumo}">
         <DockPanel IsVisible="{Binding EstiloClassico}" MaxWidth="300" HorizontalAlignment="Left">
           <TextBlock DockPanel.Dock="Top" Text="RESUMO · 12 MESES" Classes="faint" FontSize="10"
                      LetterSpacing="0.8" Margin="0,0,0,8" />
           <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0" Spacing="4" VerticalAlignment="Top"
                       ToolTip.Tip="{Binding AtivosDica}" Background="Transparent">
             <Panel Width="58" Height="58">
               <Ellipse Stroke="{DynamicResource BgActive}" StrokeThickness="6" />
               <Arc Stroke="{Binding CorDoAnel, Converter={x:Static local:Converters.ResourceBrush}}"
                    StrokeThickness="6" StrokeLineCap="Round"
                    StartAngle="-90" SweepAngle="{Binding AtivosAngulo}" />
               <TextBlock Text="{Binding AtivosTexto}" FontSize="13" FontWeight="SemiBold"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
             </Panel>
             <TextBlock Text="dias ativos" Classes="faint" FontSize="10" HorizontalAlignment="Center" />
           </StackPanel>
           <Grid ColumnDefinitions="20,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto" MinWidth="150">
             <TextBlock Grid.Row="0" Classes="glifo" FontSize="11" Foreground="{DynamicResource TextFaint}"
                        Text="{x:Static controls:Glifos.Commit}" />
             <TextBlock Grid.Row="0" Grid.Column="1" Text="Commits" Classes="faint" FontSize="11.5" Margin="0,2" />
             <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding CommitsTexto}" FontSize="12"
                        FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />

             <TextBlock Grid.Row="1" Classes="glifo" FontSize="11" Foreground="{DynamicResource TextFaint}"
                        Text="{x:Static controls:Glifos.PullRequest}" />
             <TextBlock Grid.Row="1" Grid.Column="1" Text="Pull requests" Classes="faint" FontSize="11.5" Margin="0,2" />
             <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PullRequestsTexto}" FontSize="12"
                        FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />

             <TextBlock Grid.Row="2" Classes="glifo" FontSize="11" Foreground="{DynamicResource TextFaint}"
                        Text="{x:Static controls:Glifos.Ver}" />
             <TextBlock Grid.Row="2" Grid.Column="1" Text="Revisões" Classes="faint" FontSize="11.5" Margin="0,2" />
             <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding RevisoesTexto}" FontSize="12"
                        FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />

             <TextBlock Grid.Row="3" Classes="glifo" FontSize="11" Foreground="{DynamicResource TextFaint}"
                        Text="{x:Static controls:Glifos.Issue}" />
             <TextBlock Grid.Row="3" Grid.Column="1" Text="Issues" Classes="faint" FontSize="11.5" Margin="0,2" />
             <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding IssuesTexto}" FontSize="12"
                        FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />

             <!-- o que o GitHub conta e não detalha: os repositórios que o token não enxerga -->
             <TextBlock Grid.Row="4" Classes="glifo" FontSize="11" Foreground="{DynamicResource TextFaint}"
                        Text="{x:Static controls:Glifos.Segredo}" IsVisible="{Binding TemPrivadas}" />
             <TextBlock Grid.Row="4" Grid.Column="1" Text="Privadas" Classes="faint" FontSize="11.5" Margin="0,2"
                        IsVisible="{Binding TemPrivadas}" Background="Transparent"
                        ToolTip.Tip="Contribuições que o GitHub conta mas não detalha: são de repositórios que o token não enxerga, como os da organização. Entram no quadriculado e nos dias ativos." />
             <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding PrivadasTexto}" FontSize="12"
                        FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"
                        IsVisible="{Binding TemPrivadas}" />
           </Grid>
         </DockPanel>
         <controls:PainelDeLeds IsVisible="{Binding EstiloRetro}" MaxWidth="450" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Display="{Binding DisplayDoResumo}" Cor="{Binding CorDosQuadros}"
                                Estilo="{Binding EstiloDosQuadros}" Animado="{Binding QuadrosAnimados}"
                                ToolTip.Tip="{Binding DisplayDoResumo.Descricao}" />
         </Panel>

         <!-- linguagens: das linhas dos seus commits aqui, não dos repositórios do GitHub -->
         <Panel>
         <StackPanel Spacing="8" MaxWidth="380" HorizontalAlignment="Stretch" IsVisible="{Binding LinguagensClassico}">
           <TextBlock Text="LINGUAGENS" Classes="faint" FontSize="10" LetterSpacing="0.8" Background="Transparent"
                      ToolTip.Tip="Pelas linhas dos seus commits nos repositórios desta máquina, sem repetir o histórico do par Origem × Destino" />
           <controls:BarraDeLinguagens Fatias="{Binding Fatias}" IsVisible="{Binding TemLinguagensLocais}" />
           <ItemsControl ItemsSource="{Binding Legenda}" IsVisible="{Binding TemLinguagensLocais}">
             <ItemsControl.ItemsPanel>
               <ItemsPanelTemplate>
                 <UniformGrid Columns="2" />
               </ItemsPanelTemplate>
             </ItemsControl.ItemsPanel>
             <ItemsControl.ItemTemplate>
               <DataTemplate>
                 <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                   <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                            Fill="{Binding Cor, Converter={x:Static local:Converters.StringToBrush}}" />
                   <TextBlock Text="{Binding Nome}" FontSize="11.5" VerticalAlignment="Center" />
                   <TextBlock Text="{Binding Percentual}" Classes="faint" FontSize="11" VerticalAlignment="Center" />
                 </StackPanel>
               </DataTemplate>
             </ItemsControl.ItemTemplate>
           </ItemsControl>
           <StackPanel Spacing="6" IsVisible="{Binding !TemLinguagensLocais}">
             <TextBlock Text="{Binding LinguagensConvite}" Classes="faint" FontSize="11" TextWrapping="Wrap" />
             <Button Classes="tiny verde" BorderThickness="1" BorderBrush="{DynamicResource Border}"
                     HorizontalAlignment="Left" IsVisible="{Binding !ContandoLinhas}"
                     Command="{Binding ContarLinhasCommand}"
                     ToolTip.Tip="Soma as linhas dos seus commits em cada repositório local, separadas por linguagem">
               <StackPanel Classes="comIcone">
                 <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Atualizar}" />
                 <TextBlock Text="Contar as linhas" />
               </StackPanel>
             </Button>
             <TextBlock Text="{Binding ProgressoLinhas}" Classes="faint" FontSize="10.5"
                        TextTrimming="CharacterEllipsis" IsVisible="{Binding ContandoLinhas}" />
           </StackPanel>
         </StackPanel>
         <controls:PainelDeLeds IsVisible="{Binding LinguagensRetro}" MaxWidth="450" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Display="{Binding DisplayDasLinguagens}" Cor="{Binding CorDosQuadros}"
                                Estilo="{Binding EstiloDosQuadros}" Animado="{Binding QuadrosAnimados}"
                                ToolTip.Tip="{Binding DisplayDasLinguagens.Descricao}" />
         </Panel>

         <!-- ritmo semanal: o ano somado por dia da semana -->
         <Panel IsVisible="{Binding TemRitmo}">
         <StackPanel Spacing="8" IsVisible="{Binding EstiloClassico}">
           <TextBlock Text="RITMO SEMANAL" Classes="faint" FontSize="10" LetterSpacing="0.8" />
           <StackPanel Orientation="Horizontal" Spacing="14">
             <ItemsControl ItemsSource="{Binding BarrasDaSemana}" VerticalAlignment="Bottom">
               <ItemsControl.ItemsPanel>
                 <ItemsPanelTemplate>
                   <StackPanel Orientation="Horizontal" Spacing="2" />
                 </ItemsPanelTemplate>
               </ItemsControl.ItemsPanel>
               <ItemsControl.ItemTemplate>
                 <DataTemplate>
                   <StackPanel Width="17" Spacing="3" Background="Transparent" ToolTip.Tip="{Binding Dica}">
                     <Panel Height="52">
                       <Border Width="12" Height="{Binding Altura}" VerticalAlignment="Bottom"
                               CornerRadius="3,3,0,0"
                               Background="{Binding $parent[ItemsControl].DataContext.CorDasBarras, Converter={x:Static local:Converters.ResourceBrush}}"
                               Opacity="{Binding Opacidade}" />
                     </Panel>
                     <TextBlock Text="{Binding Nome}" Classes="faint" FontSize="9.5" HorizontalAlignment="Center"
                                TextTrimming="None" />
                   </StackPanel>
                 </DataTemplate>
               </ItemsControl.ItemTemplate>
             </ItemsControl>
             <StackPanel VerticalAlignment="Bottom">
               <TextBlock Text="{Binding MaisCheioRotulo}" Classes="faint" FontSize="10" TextTrimming="None" />
               <TextBlock Text="{Binding MaisCheioNome}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
               <TextBlock Text="{Binding MaisVazioRotulo}" Classes="faint" FontSize="10" TextTrimming="None" />
               <TextBlock Text="{Binding MaisVazioNome}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4" />
               <TextBlock Text="em dias úteis" Classes="faint" FontSize="10" />
               <TextBlock Text="{Binding UteisTexto}" FontSize="14" FontWeight="SemiBold" />
             </StackPanel>
           </StackPanel>
         </StackPanel>
         <controls:PainelDeLeds IsVisible="{Binding EstiloRetro}" MaxWidth="450" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Display="{Binding DisplayDoRitmo}" Cor="{Binding CorDosQuadros}"
                                Estilo="{Binding EstiloDosQuadros}" Animado="{Binding QuadrosAnimados}"
                                ToolTip.Tip="{Binding DisplayDoRitmo.Descricao}" />
         </Panel>

         <!-- sequências: dias seguidos, o melhor dia e o melhor mês, e o ano em barrinhas -->
         <Panel IsVisible="{Binding TemSequencias}">
         <StackPanel Spacing="8" IsVisible="{Binding EstiloClassico}" MaxWidth="360" HorizontalAlignment="Stretch">
           <TextBlock Text="SEQUÊNCIAS" Classes="faint" FontSize="10" LetterSpacing="0.8" />
           <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
             <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
               <TextBlock Text="{Binding AtualTexto}" FontSize="15" FontWeight="SemiBold" />
               <TextBlock Text="sequência atual" Classes="faint" FontSize="10" />
             </StackPanel>
             <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" Background="Transparent"
                         ToolTip.Tip="{Binding MelhorDiaDica}">
               <TextBlock Text="{Binding MelhorDiaNumero}" FontSize="15" FontWeight="SemiBold" />
               <TextBlock Text="{Binding MelhorDiaRotulo}" Classes="faint" FontSize="10" />
             </StackPanel>
             <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
               <TextBlock Text="{Binding MaiorTexto}" FontSize="15" FontWeight="SemiBold" />
               <TextBlock Text="maior sequência" Classes="faint" FontSize="10" />
             </StackPanel>
             <StackPanel Grid.Row="1" Grid.Column="1" Background="Transparent"
                         ToolTip.Tip="{Binding MelhorMesDica}">
               <TextBlock Text="{Binding MelhorMesNumero}" FontSize="15" FontWeight="SemiBold" />
               <TextBlock Text="{Binding MelhorMesRotulo}" Classes="faint" FontSize="10" />
             </StackPanel>
           </Grid>
           <controls:BarrasDoAno Dias="{Binding Dias}"
                                 Destaque="{Binding CorDasBarras, Converter={x:Static local:Converters.ResourceBrush}}" />
         </StackPanel>
         <controls:PainelDeLeds IsVisible="{Binding EstiloRetro}" MaxWidth="450" HorizontalAlignment="Left" VerticalAlignment="Top"
                                Display="{Binding DisplayDasSequencias}" Cor="{Binding CorDosQuadros}"
                                Estilo="{Binding EstiloDosQuadros}" Animado="{Binding QuadrosAnimados}"
                                ToolTip.Tip="{Binding DisplayDasSequencias.Descricao}" />
         </Panel>

        </controls:GradeCartoes>
       </Border>
       </StackPanel>
      </Border>

      <!-- o "gh status": o que espera por você em todos os repositórios, da conta do perfil -->
      <Border Classes="card" Margin="0,0,0,12" Padding="14,10" IsVisible="{Binding TemEsperando}">
       <StackPanel DataContext="{Binding Esperando}" Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="sectionTitle" Text="ESPERANDO POR VOCÊ" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Resumo}" Classes="faint" FontSize="11" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Grid.Column="1" Text="Consultando…" Classes="faint" FontSize="11"
                     IsVisible="{Binding Carregando}" />
        </Grid>
        <TextBlock Text="{Binding Erro}" Foreground="{DynamicResource Red}" FontSize="11"
                   TextWrapping="Wrap" IsVisible="{Binding TemErro}" />

        <ItemsControl ItemsSource="{Binding Colunas}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:ColunaDePendencias">
              <StackPanel Margin="0,0,14,0" Spacing="2">
                <TextBlock Text="{Binding Cabecalho}" Classes="faint" FontSize="10.5" FontWeight="SemiBold"
                           Margin="0,0,0,2" />
                <TextBlock Text="{Binding Vazio}" Classes="faint" FontSize="11" TextWrapping="Wrap"
                           IsVisible="{Binding SemItens}" />
                <ItemsControl ItemsSource="{Binding Itens}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:PendenciaViewModel">
                      <Button Classes="secaoTopo" Padding="4,2" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch" ToolTip.Tip="{Binding Tooltip}"
                              Command="{Binding AbrirCommand}">
                        <StackPanel>
                          <TextBlock Text="{Binding Titulo}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Rodape}" Classes="faint" FontSize="10.5"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Classes="tiny" HorizontalAlignment="Left" Content="{Binding RestoTexto}"
                        IsVisible="{Binding TemResto}"
                        Command="{Binding AbrirRestoCommand}" />
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
       </StackPanel>
      </Border>

      <!-- uma seção por grupo, com as subpastas dentro, como na árvore. O modelo fica em
           DataTemplates, e não em ItemTemplate, para a lista de subseções de dentro achá-lo;
           no painel de um grupo sem subgrupos só o título fica escondido -->
      <ItemsControl ItemsSource="{Binding Secoes}">
        <ItemsControl.DataTemplates>
          <DataTemplate DataType="vm:SecaoPainelViewModel">
            <StackPanel Margin="0,0,0,10">

              <!-- título do grupo: clicar recolhe a seção, como o grupo na árvore -->
              <Button Classes="secaoTopo" Margin="0,0,0,6" Command="{Binding AlternarCommand}"
                      IsVisible="{Binding MostraTitulo}" HorizontalAlignment="Left"
                      ToolTip.Tip="Recolher ou abrir o grupo (vale também para a árvore)">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <TextBlock Text="{Binding Chevron}" FontSize="8" Classes="faint" Width="10"
                             FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets,Segoe UI Symbol"
                             VerticalAlignment="Center" />
                  <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                           Fill="{Binding Cor, Converter={x:Static local:Converters.StringToBrush}}" />
                  <TextBlock Text="{Binding Titulo}" FontSize="11.5" FontWeight="SemiBold"
                             VerticalAlignment="Center"
                             Foreground="{Binding Cor, Converter={x:Static local:Converters.StringToBrush}}" />
                  <TextBlock Text="{Binding Contagem}" Classes="faint" FontSize="10.5"
                             VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Pendencias}" FontSize="10.5" Margin="6,0,0,0"
                             Foreground="{DynamicResource Yellow}" VerticalAlignment="Center"
                             IsVisible="{Binding MostraPendencias}" />
                </StackPanel>
              </Button>

              <!-- corpo recuado sob o título: subpastas primeiro, depois os repositórios -->
              <StackPanel Margin="{Binding RecuoDoCorpo}" IsVisible="{Binding MostraCartoes}">
              <ItemsControl ItemsSource="{Binding Subsecoes}" IsVisible="{Binding TemSubsecoes}" />

              <ItemsControl ItemsSource="{Binding Cartoes}" Classes="cartoes">
                <!-- o cartão aberto ocupa a fileira sozinho. A marca vai no contêiner, que
                     é o filho que a grade enxerga; o ">" do Avalonia segue o pai lógico, que
                     é este ItemsControl, e a classe evita pegar as listas de dentro do cartão
                     -->
                <ItemsControl.Styles>
                  <Style Selector="ItemsControl.cartoes > ContentPresenter">
                    <Setter Property="controls:GradeCartoes.LinhaInteira" Value="{Binding Expandido}" />
                  </Style>
                </ItemsControl.Styles>
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <controls:GradeCartoes LarguraMinima="250" Espaco="10" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:CartaoRepoViewModel">
            <!-- moldura do cartão. O topo é o botão que abre e fecha; o conteúdo aberto
                 fica fora dele, senão clicar num passo da esteira fecharia o cartão -->
            <Panel Classes="cartaoMoldura">
            <Border Classes="cartaoFundo">
              <Grid ColumnDefinitions="3,*">
                <Border Grid.Column="0"
                        Background="{Binding CorDoGrupo, Converter={x:Static local:Converters.StringToBrush}}" />

               <StackPanel Grid.Column="1">
                <Button Classes="cartaoTopo" Command="{Binding AlternarCommand}"
                        ToolTip.Tip="{Binding Tooltip}" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch">
                <StackPanel Margin="11,9,11,9" Spacing="3" MinHeight="40">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Nome}" FontWeight="SemiBold"
                               FontSize="12.5" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7"
                                VerticalAlignment="Center">
                      <TextBlock Text="{Binding AheadTexto}" FontSize="11" IsVisible="{Binding MostraAhead}"
                                 Foreground="{DynamicResource Green}" />
                      <TextBlock Text="{Binding BehindTexto}" FontSize="11" IsVisible="{Binding MostraBehind}"
                                 Foreground="{DynamicResource Orange}" />
                      <TextBlock Text="{Binding ConflitoTexto}" FontSize="11" IsVisible="{Binding MostraConflito}"
                                 Foreground="{DynamicResource Red}" />
                      <TextBlock Text="{Binding SujoTexto}" FontSize="11" IsVisible="{Binding MostraSujo}"
                                 Foreground="{DynamicResource Yellow}" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Seta}" FontSize="9" Classes="faint"
                               Margin="8,0,0,0" VerticalAlignment="Center"
                               FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets,Segoe UI Symbol" />
                  </Grid>

                  <!-- segunda linha: branch, esteira e PRs, tudo como texto corrido -->
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="{Binding Branch}" Classes="faint" FontSize="10.5"
                               MaxWidth="120" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="·" Classes="faint" FontSize="10.5" IsVisible="{Binding !ConsultandoCi}" />
                    <TextBlock Text="{Binding CiSimbolo}" FontSize="10.5" IsVisible="{Binding TemCi}"
                               Foreground="{Binding CiCor, Converter={x:Static local:Converters.ResourceBrush}}" />
                    <TextBlock Text="{Binding CiTexto}" Classes="faint" FontSize="10.5"
                               IsVisible="{Binding !ConsultandoCi}" />
                    <TextBlock Text="{Binding PrTexto}" FontSize="10.5" IsVisible="{Binding TemPrs}"
                               Foreground="{DynamicResource Purple}" />
                    <TextBlock Text="indisponível" FontSize="10.5" IsVisible="{Binding TemErro}"
                               Foreground="{DynamicResource Red}" />
                  </StackPanel>
                </StackPanel>
                </Button>

                <!-- ============================================== cartão aberto
                     Montado só quando abre: escondido com IsVisible ele era construído em
                     todos os cartões, com esteira, caixa de workflow e dez botões cada, e
                     com sessenta repositórios isso prendia a tela por segundos ao abrir o app -->
                <ContentControl Content="{Binding Aberto}">
                 <ContentControl.ContentTemplate>
                  <DataTemplate DataType="vm:CartaoRepoViewModel">
                <Border Padding="11,8,11,10"
                        BorderBrush="{DynamicResource BorderSoft}" BorderThickness="0,1,0,0">
                  <StackPanel Spacing="8">

                    <TextBlock Text="Consultando a esteira…" Classes="faint" FontSize="11.5"
                               IsVisible="{Binding MostraConsultando}" />
                    <TextBlock Text="Este repositório não tem esteira (GitHub Actions)." Classes="faint"
                               FontSize="11.5" IsVisible="{Binding MostraSemEsteira}" />

                    <!-- a última execução da branch, com o passo a passo de cada job.
                         A visibilidade vem do cartão, antes de o DataContext virar a esteira -->
                    <Panel IsVisible="{Binding MostraEsteira}">
                    <StackPanel Spacing="8" DataContext="{Binding Esteira}">
                      <TextBlock Text="{Binding Erro}" FontSize="11.5" TextWrapping="Wrap"
                                 Foreground="{DynamicResource Red}" IsVisible="{Binding TemErro}" />
                      <TextBlock Text="Carregando…" Classes="faint" FontSize="11.5"
                                 IsVisible="{Binding Carregando}" />
                      <TextBlock Text="Nenhuma execução nesta branch." Classes="faint" FontSize="11.5"
                                 IsVisible="{Binding SemExecucoes}" />

                      <ItemsControl ItemsSource="{Binding Execucoes}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:CiExecucaoViewModel">
                            <Grid ColumnDefinitions="16,*,Auto" ToolTip.Tip="{Binding Tooltip}">
                              <TextBlock Grid.Column="0" Text="{Binding Simbolo}" FontSize="13"
                                         VerticalAlignment="Top"
                                         Foreground="{Binding Cor, Converter={x:Static local:Converters.ResourceBrush}}" />
                              <StackPanel Grid.Column="1" Margin="6,0">
                                <TextBlock FontSize="12" TextTrimming="CharacterEllipsis">
                                  <Run Text="{Binding Workflow}" FontWeight="SemiBold" />
                                  <Run Text=" — " />
                                  <Run Text="{Binding Titulo}" />
                                </TextBlock>
                                <TextBlock Text="{Binding Rodape}" Classes="faint" FontSize="10.5"
                                           TextTrimming="CharacterEllipsis" />
                              </StackPanel>
                              <TextBlock Grid.Column="2" Text="{Binding Numero}" Classes="faint"
                                         FontSize="10.5" VerticalAlignment="Top" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <TextBlock Text="Carregando os passos…" Classes="faint" FontSize="11.5"
                                 IsVisible="{Binding CarregandoJobs}" />

                      <ItemsControl ItemsSource="{Binding Jobs}" Margin="22,0,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:CiJobViewModel">
                            <StackPanel Margin="0,0,0,8">
                              <Grid ColumnDefinitions="16,*,Auto" Margin="0,0,0,2">
                                <TextBlock Grid.Column="0" Text="{Binding Simbolo}" FontSize="12"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Cor, Converter={x:Static local:Converters.ResourceBrush}}" />
                                <TextBlock Grid.Column="1" Text="{Binding Nome}" FontWeight="SemiBold"
                                           FontSize="11.5" Margin="6,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding DuracaoTexto}" Classes="faint"
                                           FontSize="10.5" VerticalAlignment="Center" />
                              </Grid>
                              <ItemsControl ItemsSource="{Binding Etapas}" Margin="22,0,0,0">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="vm:CiEtapaViewModel">
                                    <Grid ColumnDefinitions="14,*,Auto" Height="20">
                                      <TextBlock Grid.Column="0" Text="{Binding Simbolo}" FontSize="10.5"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding Cor, Converter={x:Static local:Converters.ResourceBrush}}" />
                                      <TextBlock Grid.Column="1" Text="{Binding Nome}" FontSize="11"
                                                 Margin="6,0" VerticalAlignment="Center"
                                                 TextTrimming="CharacterEllipsis"
                                                 Foreground="{Binding CorDoNome, Converter={x:Static local:Converters.ResourceBrush}}"
                                                 FontWeight="{Binding Peso}" />
                                      <TextBlock Grid.Column="2" Text="{Binding DuracaoTexto}" Classes="faint"
                                                 FontSize="10" VerticalAlignment="Center" />
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- ações da esteira: todas confirmam antes, como na janela -->
                      <WrapPanel>
                        <ComboBox MinWidth="140" Height="24" MinHeight="0" FontSize="11" Padding="8,0"
                                  Margin="0,0,6,4" ItemsSource="{Binding Workflows}"
                                  SelectedItem="{Binding WorkflowEscolhido}" VerticalAlignment="Center"
                                  ToolTip.Tip="Workflow que o Executar dispara, nesta branch">
                          <ComboBox.ItemTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Nome}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Classes="tiny verde" BorderThickness="1" Margin="0,0,6,4"
                                BorderBrush="{DynamicResource Border}" IsEnabled="{Binding PodeDisparar}"
                                Command="{Binding DispararCommand}"
                                ToolTip.Tip="Dispara o workflow escolhido nesta branch">
                          <StackPanel Classes="comIcone">
                            <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Esteira}" />
                            <TextBlock Text="Executar" />
                          </StackPanel>
                        </Button>
                        <Button Classes="tiny verde" BorderThickness="1" Margin="0,0,6,4"
                                BorderBrush="{DynamicResource Border}" IsEnabled="{Binding PodeReexecutar}"
                                Command="{Binding ReexecutarCommand}"
                                ToolTip.Tip="Roda de novo esta execução">
                          <StackPanel Classes="comIcone">
                            <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Atualizar}" />
                            <TextBlock Text="Reexecutar" />
                          </StackPanel>
                        </Button>
                        <Button Classes="tiny laranja" BorderThickness="1" Margin="0,0,6,4"
                                BorderBrush="{DynamicResource Border}" IsEnabled="{Binding PodeReexecutarFalhas}"
                                Command="{Binding ReexecutarFalhasCommand}"
                                ToolTip.Tip="Roda de novo apenas os jobs que falharam">
                          <StackPanel Classes="comIcone">
                            <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Atualizar}" />
                            <TextBlock Text="Só as falhas" />
                          </StackPanel>
                        </Button>
                        <Button Classes="tiny vermelho" BorderThickness="1" Margin="0,0,6,4"
                                BorderBrush="{DynamicResource Border}" IsEnabled="{Binding PodeCancelar}"
                                Command="{Binding CancelarCommand}"
                                ToolTip.Tip="Cancela a execução, que ainda está rodando">
                          <StackPanel Classes="comIcone">
                            <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Parar}" />
                            <TextBlock Text="Parar" />
                          </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding RitmoTexto}" Classes="faint" FontSize="10.5"
                                   VerticalAlignment="Center" Margin="4,0,0,4" />
                      </WrapPanel>
                    </StackPanel>
                    </Panel>

                    <!-- ações do repositório, valem com ou sem esteira -->
                    <WrapPanel>
                      <Button Classes="tiny azul" BorderThickness="1" Margin="0,0,6,0"
                              BorderBrush="{DynamicResource Border}" Command="{Binding AbrirCommand}"
                              ToolTip.Tip="Abre as abas de alterações e histórico deste repositório">
                        <StackPanel Classes="comIcone">
                          <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Abrir}" />
                          <TextBlock Text="Abrir repositório" />
                        </StackPanel>
                      </Button>
                      <Button Classes="tiny azul" BorderThickness="1" Margin="0,0,6,0"
                              BorderBrush="{DynamicResource Border}" IsVisible="{Binding TemCi}"
                              Command="{Binding AbrirEsteiraCommand}"
                              ToolTip.Tip="Abre a janela da esteira, com o histórico e os filtros">
                        <StackPanel Classes="comIcone">
                          <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Esteira}" />
                          <TextBlock Text="Ver todas as execuções" />
                        </StackPanel>
                      </Button>
                      <Button Classes="tiny roxo" BorderThickness="1" Margin="0,0,6,0"
                              BorderBrush="{DynamicResource Border}" IsVisible="{Binding TemGitHub}"
                              Command="{Binding AbrirPrsCommand}"
                              ToolTip.Tip="Ver os pull requests, criar o da branch atual e mesclar">
                        <StackPanel Classes="comIcone">
                          <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.PullRequest}" />
                          <TextBlock Text="Pull requests" />
                        </StackPanel>
                      </Button>
                      <Button Classes="tiny verde" BorderThickness="1" Margin="0,0,6,0"
                              BorderBrush="{DynamicResource Border}" IsVisible="{Binding TemGitHub}"
                              Command="{Binding AbrirIssuesCommand}"
                              ToolTip.Tip="Issues do repositório: abertas, fechadas e etiquetas">
                        <StackPanel Classes="comIcone">
                          <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Issue}" />
                          <TextBlock Text="Issues" />
                        </StackPanel>
                      </Button>
                      <Button Classes="tiny amarelo" BorderThickness="1" Margin="0,0,6,0"
                              BorderBrush="{DynamicResource Border}" Command="{Binding AbrirPastaCommand}"
                              ToolTip.Tip="Abre a pasta do repositório no Explorer">
                        <StackPanel Classes="comIcone">
                          <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Pasta}" />
                          <TextBlock Text="Pasta" />
                        </StackPanel>
                      </Button>
                      <Button Classes="tiny cinza" BorderThickness="1" Margin="0,0,6,0"
                              BorderBrush="{DynamicResource Border}" Command="{Binding AbrirTerminalCommand}"
                              ToolTip.Tip="Abre o Git Bash na pasta do repositório">
                        <StackPanel Classes="comIcone">
                          <TextBlock Classes="glifo" Text="{x:Static controls:Glifos.Terminal}" />
                          <TextBlock Text="Terminal" />
                        </StackPanel>
                      </Button>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                  </DataTemplate>
                 </ContentControl.ContentTemplate>
                </ContentControl>
               </StackPanel>
              </Grid>
            </Border>
            <!-- contorno por cima de tudo: faixa do grupo e fundo do topo (no hover) ficam
                 por baixo dele, e a linha não aparece mais cortada nos cantos -->
            <Border Classes="cartaoContorno" IsHitTestVisible="False" />
            </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.DataTemplates>
      </ItemsControl>
     </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
