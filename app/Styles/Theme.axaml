<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:GRepos.Controls">

  <Styles.Resources>
    <ResourceDictionary>

      <!-- ícones da barra de ferramentas, traçados em uma caixa de 24x24 -->
      <StreamGeometry x:Key="IconFetch">M3,12 A9,9 0 1,1 21,12 A9,9 0 1,1 3,12 M12,6 L12,13 M9,10 L12,13 L15,10 M8,16.5 L16,16.5</StreamGeometry>
      <StreamGeometry x:Key="IconPull">M3,12 A9,9 0 1,1 21,12 A9,9 0 1,1 3,12 M12,7 L12,16 M8.5,12.5 L12,16 L15.5,12.5</StreamGeometry>
      <StreamGeometry x:Key="IconPush">M3,12 A9,9 0 1,1 21,12 A9,9 0 1,1 3,12 M12,17 L12,8 M8.5,11.5 L12,8 L15.5,11.5</StreamGeometry>
      <StreamGeometry x:Key="IconBranch">M7,4 A2,2 0 1,1 7,8 A2,2 0 1,1 7,4 M7,8 L7,16 M7,16 A2,2 0 1,1 7,20 A2,2 0 1,1 7,16 M17,4 A2,2 0 1,1 17,8 A2,2 0 1,1 17,4 M17,8 C17,13 7,11 7,16</StreamGeometry>
      <StreamGeometry x:Key="IconDesfazer">M8,5 L4,9 L8,13 M4,9 L15,9 A5,5 0 0,1 15,19 L9,19</StreamGeometry>
      <StreamGeometry x:Key="IconStash">M4,10 L20,10 L20,19 L4,19 Z M4,10 L6.5,5.5 L17.5,5.5 L20,10 M9.5,14 L14.5,14</StreamGeometry>
      <StreamGeometry x:Key="IconRemoto">M12,3 A9,9 0 1,1 12,21 A9,9 0 1,1 12,3 M3.5,9.5 L20.5,9.5 M3.5,14.5 L20.5,14.5 M12,3 C9,6.5 9,17.5 12,21 M12,3 C15,6.5 15,17.5 12,21</StreamGeometry>
      <StreamGeometry x:Key="IconLocal">M3,6.5 L10,6.5 L12,9 L21,9 L21,19 L3,19 Z</StreamGeometry>
      <StreamGeometry x:Key="IconTerminal">M3,5 L21,5 L21,19 L3,19 Z M7,9.5 L10,12 L7,14.5 M12,15 L17,15</StreamGeometry>
      <StreamGeometry x:Key="IconPr">M6,4 A2,2 0 1,1 6,8 A2,2 0 1,1 6,4 M6,8 L6,16 M6,16 A2,2 0 1,1 6,20 A2,2 0 1,1 6,16 M18,16 A2,2 0 1,1 18,20 A2,2 0 1,1 18,16 M18,16 L18,9 A3,3 0 0,0 15,6 L11,6 M13.5,3.5 L11,6 L13.5,8.5</StreamGeometry>
      <StreamGeometry x:Key="IconIssue">M12,3 A9,9 0 1,1 12,21 A9,9 0 1,1 12,3 M12,10.5 A1.5,1.5 0 1,1 12,13.5 A1.5,1.5 0 1,1 12,10.5</StreamGeometry>
      <StreamGeometry x:Key="IconEsteira">M4,17 L9,17 M15,17 L20,17 M12,7 A5,5 0 1,1 12,17 A5,5 0 1,1 12,7 M12,10.5 L12,13.5 M10.5,12 L13.5,12</StreamGeometry>
      <StreamGeometry x:Key="IconSplit">M3,5 L21,5 L21,19 L3,19 Z M12,5 L12,19</StreamGeometry>
      <StreamGeometry x:Key="IconWrap">M4,6 L20,6 M4,12 L17,12 A3,3 0 0,1 17,18 L9,18 M12,15 L9,18 L12,21 M4,18 L6,18</StreamGeometry>
      <StreamGeometry x:Key="IconConfig">M12,9 A3,3 0 1,1 12,15 A3,3 0 1,1 12,9 M12,3 L12,5.5 M12,18.5 L12,21 M3,12 L5.5,12 M18.5,12 L21,12 M5.6,5.6 L7.4,7.4 M16.6,16.6 L18.4,18.4 M18.4,5.6 L16.6,7.4 M7.4,16.6 L5.6,18.4</StreamGeometry>
      <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Bg" Color="#0F1217" />
          <SolidColorBrush x:Key="BgPanel" Color="#12151B" />
          <SolidColorBrush x:Key="BgRaised" Color="#161A21" />
          <SolidColorBrush x:Key="BgHover" Color="#1D222B" />
          <SolidColorBrush x:Key="BgActive" Color="#232A35" />
          <SolidColorBrush x:Key="Border" Color="#242A34" />
          <SolidColorBrush x:Key="BorderSoft" Color="#1B2028" />
          <SolidColorBrush x:Key="Text" Color="#DFE4EC" />
          <SolidColorBrush x:Key="TextDim" Color="#8B95A6" />
          <SolidColorBrush x:Key="TextFaint" Color="#707B8C" />
          <SolidColorBrush x:Key="AddBg" Color="#1B3326" />
          <SolidColorBrush x:Key="DelBg" Color="#3A2028" />
          <SolidColorBrush x:Key="GutterBg" Color="#14181F" />
          <SolidColorBrush x:Key="AddGutter" Color="#23472F" />
          <SolidColorBrush x:Key="DelGutter" Color="#52262F" />
          <SolidColorBrush x:Key="HunkBg" Color="#152238" />

          <!-- realce de sintaxe do diff, na paleta do GitHub -->
          <SolidColorBrush x:Key="SynPalavra" Color="#FF7B72" />
          <SolidColorBrush x:Key="SynLiteral" Color="#A5D6FF" />
          <SolidColorBrush x:Key="SynComentario" Color="#8B949E" />
          <SolidColorBrush x:Key="SynNumero" Color="#79C0FF" />
          <SolidColorBrush x:Key="SynFuncao" Color="#D2A8FF" />

          <!-- cores de estado: claras, para contrastar com o fundo escuro -->
          <SolidColorBrush x:Key="Accent" Color="#4F8CFF" />
          <SolidColorBrush x:Key="OnAccent" Color="#08121F" />
          <SolidColorBrush x:Key="Green" Color="#3FB950" />
          <SolidColorBrush x:Key="Red" Color="#FF7B72" />
          <SolidColorBrush x:Key="Orange" Color="#F0883E" />
          <SolidColorBrush x:Key="Yellow" Color="#E3B341" />
          <SolidColorBrush x:Key="Purple" Color="#D2A8FF" />

          <SolidColorBrush x:Key="Lane0" Color="#4F8CFF" />
          <SolidColorBrush x:Key="Lane1" Color="#F0883E" />
          <SolidColorBrush x:Key="Lane2" Color="#3FB950" />
          <SolidColorBrush x:Key="Lane3" Color="#D2A8FF" />
          <SolidColorBrush x:Key="Lane4" Color="#FF7B72" />
          <SolidColorBrush x:Key="Lane5" Color="#79C0FF" />
          <SolidColorBrush x:Key="Lane6" Color="#E3B341" />
          <SolidColorBrush x:Key="Lane7" Color="#56D4BC" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Bg" Color="#F2F4F7" />
          <SolidColorBrush x:Key="BgPanel" Color="#FFFFFF" />
          <SolidColorBrush x:Key="BgRaised" Color="#FFFFFF" />
          <SolidColorBrush x:Key="BgHover" Color="#E8EDF3" />
          <SolidColorBrush x:Key="BgActive" Color="#D7E3F7" />
          <SolidColorBrush x:Key="Border" Color="#C7D0DA" />
          <SolidColorBrush x:Key="BorderSoft" Color="#DEE4EB" />
          <SolidColorBrush x:Key="Text" Color="#14181F" />
          <SolidColorBrush x:Key="TextDim" Color="#44505F" />
          <SolidColorBrush x:Key="TextFaint" Color="#61707F" />
          <SolidColorBrush x:Key="AddBg" Color="#D6F5DE" />
          <SolidColorBrush x:Key="DelBg" Color="#FFE1DE" />
          <SolidColorBrush x:Key="GutterBg" Color="#EDF0F4" />
          <SolidColorBrush x:Key="AddGutter" Color="#B9EBC6" />
          <SolidColorBrush x:Key="DelGutter" Color="#FFCDC8" />
          <SolidColorBrush x:Key="HunkBg" Color="#DDEEFF" />

          <SolidColorBrush x:Key="SynPalavra" Color="#CF222E" />
          <SolidColorBrush x:Key="SynLiteral" Color="#0A3069" />
          <SolidColorBrush x:Key="SynComentario" Color="#5F6975" />
          <SolidColorBrush x:Key="SynNumero" Color="#0550AE" />
          <SolidColorBrush x:Key="SynFuncao" Color="#7A3FD1" />

          <!-- as mesmas cores em tons escuros: sobre branco as claras somem -->
          <SolidColorBrush x:Key="Accent" Color="#1F6FEB" />
          <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Green" Color="#17803D" />
          <SolidColorBrush x:Key="Red" Color="#C5221F" />
          <SolidColorBrush x:Key="Orange" Color="#B44B00" />
          <SolidColorBrush x:Key="Yellow" Color="#8A6100" />
          <SolidColorBrush x:Key="Purple" Color="#6A35B8" />

          <SolidColorBrush x:Key="Lane0" Color="#1F6FEB" />
          <SolidColorBrush x:Key="Lane1" Color="#B44B00" />
          <SolidColorBrush x:Key="Lane2" Color="#17803D" />
          <SolidColorBrush x:Key="Lane3" Color="#6A35B8" />
          <SolidColorBrush x:Key="Lane4" Color="#C5221F" />
          <SolidColorBrush x:Key="Lane5" Color="#0B62C4" />
          <SolidColorBrush x:Key="Lane6" Color="#8A6100" />
          <SolidColorBrush x:Key="Lane7" Color="#0E7C6B" />
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>

      <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas,Courier New,monospace</FontFamily>
      <x:Double x:Key="RowHeight">26</x:Double>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- base -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Bg}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
  </Style>

  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
  </Style>

  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- botões -->

  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource BgRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Height" Value="28" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource Text}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource OnAccent}" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.tiny">
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- ação em pílula: botão pequeno, mas com corpo — contorno, fundo e cantos redondos —
       para uma fileira de ações que precisa se destacar do texto em volta -->
  <Style Selector="Button.acao">
    <Setter Property="Height" Value="24" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.acao:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgActive}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <!-- a pílula ligada (o Markdown ativo): contorno e texto na cor de destaque -->
  <Style Selector="Button.acao.destacado">
    <Setter Property="Background" Value="{DynamicResource BgActive}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="Button.acao.destacado:pointerover /template/ ContentPresenter">
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="Button.acao.danger:pointerover /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{DynamicResource Red}" />
  </Style>

  <!-- a opção em vigor entre botões pequenos lado a lado (o lado escolhido num conflito) -->
  <Style Selector="Button.tiny.destacado">
    <Setter Property="Background" Value="{DynamicResource BgActive}" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <!-- pílula da branch na árvore: o contorno é a cor do tipo de branch e precisa
       sobreviver ao hover, que no botão comum troca a borda pela cinza -->
  <Style Selector="Button.pilulaBranch">
    <Setter Property="Height" Value="17" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.pilulaBranch:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgActive}" />
    <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
  </Style>

  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource Red}" />
  </Style>

  <!-- barra de ferramentas: ícone grande com legenda embaixo -->
  <Style Selector="controls|ToolButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="Height" Value="NaN" />
    <Setter Property="Padding" Value="8,3,8,2" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="Fundo" Background="{TemplateBinding Background}" CornerRadius="6"
                Padding="{TemplateBinding Padding}">
          <StackPanel Spacing="2">
            <Panel Width="21" Height="21" HorizontalAlignment="Center">
              <Path Data="{TemplateBinding Icon}"
                    Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4"
                    StrokeJoin="Round" StrokeLineCap="Round"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Stretch="Uniform" Width="18" Height="18" />
              <Border Name="Selo" IsVisible="False" Background="{DynamicResource Accent}"
                      CornerRadius="6" MinWidth="13" Height="13" Padding="3,0"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0">
                <TextBlock Text="{TemplateBinding Badge}" FontSize="9" Foreground="{DynamicResource OnAccent}"
                           FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Panel>
            <TextBlock Text="{TemplateBinding Label}" FontSize="10"
                       Foreground="{TemplateBinding Foreground}"
                       HorizontalAlignment="Center" />
          </StackPanel>
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|ToolButton:hasbadge /template/ Border#Selo">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="controls|ToolButton:pointerover /template/ Border#Fundo">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
  </Style>

  <Style Selector="controls|ToolButton:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <!-- botão em evidência (ex.: branch fora da principal) -->
  <Style Selector="controls|ToolButton.destacado">
    <Setter Property="Foreground" Value="{DynamicResource Orange}" />
  </Style>

  <Style Selector="controls|ToolButton.destacado /template/ Border#Fundo">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
  </Style>

  <Style Selector="controls|ToolButton:disabled">
    <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
    <Setter Property="Opacity" Value="0.55" />
  </Style>

  <!-- botão só de ícone: a legenda vive no ToolTip -->
  <Style Selector="Button.icon">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons,Segoe MDL2 Assets,Segoe UI Symbol" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
  </Style>

  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <!-- entradas -->

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="7,4" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Bg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
  </Style>

  <!-- listas -->

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
  </Style>

  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgActive}" />
  </Style>

  <!-- abas -->

  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Height" Value="38" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
  </Style>

  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>

  <Style Selector="TabControl">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- containers -->

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource BgPanel}" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource BgRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>

  <!-- cartão do painel: é um Button para o clique valer no cartão inteiro, mas não
       deve parecer botão — daí herdar a moldura do card e só acender ao passar o mouse -->
  <Style Selector="Button.cartao">
    <Setter Property="Background" Value="{DynamicResource BgPanel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
    <!-- o estilo base de Button fixa Height 28; aqui o cartão cresce com o conteúdo -->
    <Setter Property="Height" Value="NaN" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Button.cartao /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="Button.cartao:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextFaint}" />
  </Style>

  <!-- cartão do painel que expande. Duas camadas: o fundo recorta o conteúdo no
       retângulo arredondado, e o contorno vem por cima, sozinho. Com a borda no mesmo
       Border do conteúdo, a faixa do grupo e o fundo do topo no hover cobriam a linha
       nos cantos e ela parecia cortada (EV05) -->
  <Style Selector="Border.cartaoFundo">
    <Setter Property="Background" Value="{DynamicResource BgPanel}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.cartaoContorno">
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="Panel.cartaoMoldura:pointerover > Border.cartaoContorno">
    <Setter Property="BorderBrush" Value="{DynamicResource TextFaint}" />
  </Style>

  <Style Selector="Button.cartaoTopo">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Height" Value="NaN" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.cartaoTopo:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
  </Style>

  <!-- título de grupo no painel: linha clicável discreta, como o grupo na árvore -->
  <Style Selector="Button.secaoTopo">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="4,3,10,3" />
    <Setter Property="Height" Value="NaN" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.secaoTopo:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="Margin" Value="0,0,5,0" />
  </Style>

  <!-- Barra de rolagem fina e sem setas. A barra permanente do tema Fluent traz
       setinhas nas pontas e um fundo próprio que, ao rolar, piscam como sujeira no
       canto. Aqui sobra o indicador: largura fixa, fundo transparente e cantos
       arredondados. A largura fixa é o que mantém o espaço reservado no layout. -->
  <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ScrollBar /template/ RepeatButton#PART_LineDownButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="9" />
    <Setter Property="MinWidth" Value="9" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ScrollBar:horizontal">
    <Setter Property="Height" Value="9" />
    <Setter Property="MinHeight" Value="9" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ScrollBar /template/ Border">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource Border}" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <Style Selector="ScrollBar:pointerover /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource TextFaint}" />
  </Style>

</Styles>
