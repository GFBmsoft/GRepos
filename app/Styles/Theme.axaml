<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:GRepos.Controls">

  <Styles.Resources>
    <ResourceDictionary>

      <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="Bg" Color="#0F1217" />
          <SolidColorBrush x:Key="BgPanel" Color="#12151B" />
          <SolidColorBrush x:Key="BgRaised" Color="#161A21" />
          <SolidColorBrush x:Key="BgHover" Color="#1D222B" />
          <SolidColorBrush x:Key="BgActive" Color="#232A35" />
          <SolidColorBrush x:Key="Border" Color="#242A34" />
          <SolidColorBrush x:Key="BorderSoft" Color="#1B2028" />
          <SolidColorBrush x:Key="Text" Color="#DFE4EC" />
          <SolidColorBrush x:Key="TextDim" Color="#8B95A6" />
          <SolidColorBrush x:Key="TextFaint" Color="#707B8C" />
          <SolidColorBrush x:Key="AddBg" Color="#1B3326" />
          <SolidColorBrush x:Key="DelBg" Color="#3A2028" />
          <SolidColorBrush x:Key="GutterBg" Color="#14181F" />
          <SolidColorBrush x:Key="AddGutter" Color="#23472F" />
          <SolidColorBrush x:Key="DelGutter" Color="#52262F" />
          <SolidColorBrush x:Key="HunkBg" Color="#152238" />

          <!-- realce de sintaxe do diff, na paleta do GitHub -->
          <SolidColorBrush x:Key="SynPalavra" Color="#FF7B72" />
          <SolidColorBrush x:Key="SynLiteral" Color="#A5D6FF" />
          <SolidColorBrush x:Key="SynComentario" Color="#8B949E" />
          <SolidColorBrush x:Key="SynNumero" Color="#79C0FF" />
          <SolidColorBrush x:Key="SynFuncao" Color="#D2A8FF" />

          <!-- cores de estado: claras, para contrastar com o fundo escuro -->
          <SolidColorBrush x:Key="Accent" Color="#4F8CFF" />
          <SolidColorBrush x:Key="OnAccent" Color="#08121F" />
          <SolidColorBrush x:Key="Green" Color="#3FB950" />
          <SolidColorBrush x:Key="Red" Color="#FF7B72" />
          <SolidColorBrush x:Key="Orange" Color="#F0883E" />
          <SolidColorBrush x:Key="Yellow" Color="#E3B341" />
          <SolidColorBrush x:Key="Purple" Color="#D2A8FF" />

          <SolidColorBrush x:Key="Lane0" Color="#4F8CFF" />
          <SolidColorBrush x:Key="Lane1" Color="#F0883E" />
          <SolidColorBrush x:Key="Lane2" Color="#3FB950" />
          <SolidColorBrush x:Key="Lane3" Color="#D2A8FF" />
          <SolidColorBrush x:Key="Lane4" Color="#FF7B72" />
          <SolidColorBrush x:Key="Lane5" Color="#79C0FF" />
          <SolidColorBrush x:Key="Lane6" Color="#E3B341" />
          <SolidColorBrush x:Key="Lane7" Color="#56D4BC" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="Bg" Color="#F2F4F7" />
          <SolidColorBrush x:Key="BgPanel" Color="#FFFFFF" />
          <SolidColorBrush x:Key="BgRaised" Color="#FFFFFF" />
          <SolidColorBrush x:Key="BgHover" Color="#E8EDF3" />
          <SolidColorBrush x:Key="BgActive" Color="#D7E3F7" />
          <SolidColorBrush x:Key="Border" Color="#C7D0DA" />
          <SolidColorBrush x:Key="BorderSoft" Color="#DEE4EB" />
          <SolidColorBrush x:Key="Text" Color="#14181F" />
          <SolidColorBrush x:Key="TextDim" Color="#44505F" />
          <SolidColorBrush x:Key="TextFaint" Color="#61707F" />
          <SolidColorBrush x:Key="AddBg" Color="#D6F5DE" />
          <SolidColorBrush x:Key="DelBg" Color="#FFE1DE" />
          <SolidColorBrush x:Key="GutterBg" Color="#EDF0F4" />
          <SolidColorBrush x:Key="AddGutter" Color="#B9EBC6" />
          <SolidColorBrush x:Key="DelGutter" Color="#FFCDC8" />
          <SolidColorBrush x:Key="HunkBg" Color="#DDEEFF" />

          <SolidColorBrush x:Key="SynPalavra" Color="#CF222E" />
          <SolidColorBrush x:Key="SynLiteral" Color="#0A3069" />
          <SolidColorBrush x:Key="SynComentario" Color="#5F6975" />
          <SolidColorBrush x:Key="SynNumero" Color="#0550AE" />
          <SolidColorBrush x:Key="SynFuncao" Color="#7A3FD1" />

          <!-- as mesmas cores em tons escuros: sobre branco as claras somem -->
          <SolidColorBrush x:Key="Accent" Color="#1F6FEB" />
          <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
          <SolidColorBrush x:Key="Green" Color="#17803D" />
          <SolidColorBrush x:Key="Red" Color="#C5221F" />
          <SolidColorBrush x:Key="Orange" Color="#B44B00" />
          <SolidColorBrush x:Key="Yellow" Color="#8A6100" />
          <SolidColorBrush x:Key="Purple" Color="#6A35B8" />

          <SolidColorBrush x:Key="Lane0" Color="#1F6FEB" />
          <SolidColorBrush x:Key="Lane1" Color="#B44B00" />
          <SolidColorBrush x:Key="Lane2" Color="#17803D" />
          <SolidColorBrush x:Key="Lane3" Color="#6A35B8" />
          <SolidColorBrush x:Key="Lane4" Color="#C5221F" />
          <SolidColorBrush x:Key="Lane5" Color="#0B62C4" />
          <SolidColorBrush x:Key="Lane6" Color="#8A6100" />
          <SolidColorBrush x:Key="Lane7" Color="#0E7C6B" />
        </ResourceDictionary>

      </ResourceDictionary.ThemeDictionaries>

      <FontFamily x:Key="MonoFont">Cascadia Mono,Consolas,Courier New,monospace</FontFamily>
      <FontFamily x:Key="GlyphFont">Segoe Fluent Icons,Segoe MDL2 Assets,Segoe UI Symbol</FontFamily>
      <!-- fundo e contorno das pílulas azuis; o ApplyTheme troca pela cor de destaque escolhida -->
      <SolidColorBrush x:Key="AccentFundo" Color="#242F7BE8" />
      <SolidColorBrush x:Key="AccentContorno" Color="#662F7BE8" />
      <x:Double x:Key="RowHeight">26</x:Double>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- base -->

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Bg}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
  </Style>

  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
  </Style>

  <Style Selector="TextBlock.sectionTitle">
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- botões: tudo em pílula, no padrão do GRemote, do GConv e do GTest. O glifo e o texto na
       cor cheia, o fundo com a cor diluída (#24) e o contorno meio diluído (#66); com o mouse
       em cima, o fundo fica no tom do contorno. A cor é uma classe, uma por tipo de ação
       (a tabela está mais abaixo, depois da barra de ferramentas):
         azul      ver, abrir, comparar, salvar
         verde     criar, trocar, preparar, trazer
         roxo      mexer no histórico: mesclar, rebase, cherry-pick, PR
         laranja   enviar e o que pede atenção
         amarelo   marcar e guardar: tag, stash, ignorar
         vermelho  excluir, descartar, resetar
         cinza     copiar, configurar, cancelar (é o botão sem classe)
       Tamanhos: o comum (28), "pilula" (26), "pequena" (22); "redonda" é só o ícone, numa
       bolinha. As classes antigas continuam valendo: acao = pilula, tiny = pequena,
       primary = azul, danger = vermelho -->
  <Style Selector="Button">
    <Setter Property="Background" Value="#246B7280" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="BorderBrush" Value="#666B7280" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Height" Value="28" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button:pointerover /template/ ContentPresenter, Button:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{Binding $parent[Button].BorderBrush}" />
    <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{Binding $parent[Button].Foreground}" />
  </Style>

  <!-- desligado: a mesma pílula, apagada; sem isto valia o cinza do tema Fluent -->
  <Style Selector="Button:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
    <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
    <Setter Property="TextBlock.Foreground" Value="{Binding $parent[Button].Foreground}" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- Só o conteúdo DIRETO do botão (o ">"): o menu que ele abre é descendente lógico dele,
       e com o seletor de descendente os itens do menu saíam lado a lado, vazando da janela
       (foi o EV03 do GRemote). Quem confere é Menus_dos_botoes_ficam_em_coluna -->
  <Style Selector="Button > TextBlock:not(.faint):not(.dim), Button > StackPanel.comIcone > TextBlock:not(.faint):not(.dim)">
    <Setter Property="Foreground" Value="{Binding $parent[Button].Foreground}" />
  </Style>

  <Style Selector="Button > StackPanel.comIcone">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="6" />
  </Style>

  <Style Selector="Button > StackPanel.comIcone > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.pilula, Button.acao">
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="11,0" />
    <Setter Property="CornerRadius" Value="13" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="Button.pequena, Button.tiny">
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style Selector="Button.pequena > StackPanel.comIcone, Button.tiny > StackPanel.comIcone">
    <Setter Property="Spacing" Value="5" />
  </Style>

  <Style Selector="Button.pequena > StackPanel.comIcone > TextBlock.glifo, Button.tiny > StackPanel.comIcone > TextBlock.glifo">
    <Setter Property="FontSize" Value="10.5" />
  </Style>

  <!-- só o ícone, numa bolinha do tamanho da altura -->
  <Style Selector="Button.redonda">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="13" />
  </Style>

  <Style Selector="Button.redonda.pequena, Button.redonda.tiny">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="11" />
  </Style>

  <Style Selector="Button.redonda > TextBlock.glifo">
    <Setter Property="HorizontalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.redonda.pequena > TextBlock.glifo, Button.redonda.tiny > TextBlock.glifo">
    <Setter Property="FontSize" Value="10.5" />
  </Style>

  <!-- pílula da branch na árvore: o contorno é a cor do tipo de branch e precisa
       sobreviver ao hover, que no botão comum troca a borda pela cinza -->
  <Style Selector="Button.pilulaBranch">
    <Setter Property="Height" Value="17" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.pilulaBranch:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgActive}" />
    <Setter Property="BorderBrush" Value="{Binding $parent[Button].BorderBrush}" />
  </Style>

  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource Red}" />
  </Style>

  <!-- barra de ferramentas: pílula com o glifo e a legenda ao lado. Sem espaço (BarraCompacta)
       vira bolinha só com o glifo, como a barra da sessão no GRemote -->
  <Style Selector="controls|ToolButton">
    <Setter Property="Background" Value="#246B7280" />
    <Setter Property="BorderBrush" Value="#666B7280" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
          <Border Name="Fundo" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="13"
                  Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
              <TextBlock Classes="glifo" Text="{TemplateBinding Glifo}" FontSize="13"
                         Foreground="{TemplateBinding Foreground}" />
              <TextBlock Name="Legenda" Text="{TemplateBinding Label}" FontSize="12"
                         Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Border Name="Selo" IsVisible="False" Background="{DynamicResource Accent}"
                  CornerRadius="7" MinWidth="14" Height="14" Padding="3,0"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0">
            <TextBlock Text="{TemplateBinding Badge}" FontSize="9" Foreground="{DynamicResource OnAccent}"
                       FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="controls|ToolButton:hasbadge /template/ Border#Selo">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="controls|ToolButton:pointerover /template/ Border#Fundo, controls|ToolButton:pressed /template/ Border#Fundo">
    <Setter Property="Background" Value="{Binding $parent[Button].BorderBrush}" />
  </Style>

  <Style Selector="controls|ToolButton:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!-- as cores das pílulas: Foreground no tema, fundo #24 e contorno #66 da paleta do GTerm,
       a mesma do GRemote. O azul sai da cor de destaque, que o usuário escolhe -->
  <Style Selector=":is(Button).azul, Button.primary">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="{DynamicResource AccentFundo}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentContorno}" />
  </Style>
  <Style Selector=":is(Button).verde">
    <Setter Property="Foreground" Value="{DynamicResource Green}" />
    <Setter Property="Background" Value="#241F9D55" />
    <Setter Property="BorderBrush" Value="#661F9D55" />
  </Style>
  <Style Selector=":is(Button).roxo">
    <Setter Property="Foreground" Value="{DynamicResource Purple}" />
    <Setter Property="Background" Value="#248B5CF6" />
    <Setter Property="BorderBrush" Value="#668B5CF6" />
  </Style>
  <Style Selector=":is(Button).laranja">
    <Setter Property="Foreground" Value="{DynamicResource Orange}" />
    <Setter Property="Background" Value="#24E07B00" />
    <Setter Property="BorderBrush" Value="#66E07B00" />
  </Style>
  <Style Selector=":is(Button).amarelo">
    <Setter Property="Foreground" Value="{DynamicResource Yellow}" />
    <Setter Property="Background" Value="#24B08500" />
    <Setter Property="BorderBrush" Value="#66B08500" />
  </Style>
  <Style Selector=":is(Button).vermelho, Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource Red}" />
    <Setter Property="Background" Value="#24D93F3F" />
    <Setter Property="BorderBrush" Value="#66D93F3F" />
  </Style>
  <Style Selector=":is(Button).cinza">
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
    <Setter Property="Background" Value="#246B7280" />
    <Setter Property="BorderBrush" Value="#666B7280" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- a pílula ligada (o Markdown ativo, o lado escolhido num conflito) -->
  <Style Selector="Button.destacado">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="Background" Value="{DynamicResource AccentContorno}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <!-- botão da barra em evidência (branch fora da principal, terminal aberto) -->
  <Style Selector="controls|ToolButton.destacado">
    <Setter Property="Foreground" Value="{DynamicResource Orange}" />
    <Setter Property="Background" Value="#24E07B00" />
    <Setter Property="BorderBrush" Value="#66E07B00" />
  </Style>

  <!-- glifo solto, nos botões e nos menus; as classes de cor servem para ele também -->
  <Style Selector="TextBlock.glifo">
    <Setter Property="FontFamily" Value="{DynamicResource GlyphFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="None" />
  </Style>
  <Style Selector="TextBlock.azul"><Setter Property="Foreground" Value="{DynamicResource Accent}" /></Style>
  <Style Selector="TextBlock.verde"><Setter Property="Foreground" Value="{DynamicResource Green}" /></Style>
  <Style Selector="TextBlock.roxo"><Setter Property="Foreground" Value="{DynamicResource Purple}" /></Style>
  <Style Selector="TextBlock.laranja"><Setter Property="Foreground" Value="{DynamicResource Orange}" /></Style>
  <Style Selector="TextBlock.amarelo"><Setter Property="Foreground" Value="{DynamicResource Yellow}" /></Style>
  <Style Selector="TextBlock.vermelho"><Setter Property="Foreground" Value="{DynamicResource Red}" /></Style>
  <Style Selector="TextBlock.cinza"><Setter Property="Foreground" Value="{DynamicResource TextDim}" /></Style>

  <!-- menus: cartão arredondado, item em pílula e o glifo na cor da ação (ItemDeMenu) -->
  <Style Selector="MenuFlyoutPresenter, ContextMenu">
    <Setter Property="Background" Value="{DynamicResource BgRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="5" />
  </Style>

  <Style Selector="MenuItem">
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="FontSize" Value="12.5" />
  </Style>

  <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot, MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
  </Style>

  <Style Selector="MenuItem:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="MenuItem TextBlock.glifo">
    <Setter Property="FontSize" Value="14" />
  </Style>

  <Style Selector="MenuFlyoutPresenter Separator, ContextMenu Separator">
    <Setter Property="Background" Value="{DynamicResource BorderSoft}" />
    <Setter Property="Margin" Value="4,4" />
  </Style>

  <!-- nome e pasta do repositório na barra: com teto, senão um nome comprido empurra os
       botões da direita para fora -->
  <Style Selector="TextBlock.nomeNaBarra">
    <Setter Property="MaxWidth" Value="200" />
  </Style>

  <!-- barra que não cabe na janela: só as bolinhas, e a legenda fica na dica (BarraCompacta).
       A branch mantém o nome, que é informação e não só rótulo. "soIcone" é o botão que nunca
       tem legenda: abrir fora daqui e exibir o diff, a parte menos usada da barra. Com a
       legenda neles, a barra cheia não sobrava vão para o aviso na largura padrão -->
  <Style Selector="controls|ToolButton.soIcone /template/ TextBlock#Legenda, Border.barraCompacta controls|ToolButton:not(.semCompactar) /template/ TextBlock#Legenda">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="controls|ToolButton.soIcone, Border.barraCompacta controls|ToolButton:not(.semCompactar)">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="26" />
  </Style>

  <Style Selector="Border.barraCompacta controls|ToolButton">
    <Setter Property="Margin" Value="1,0" />
  </Style>

  <Style Selector="Border.barraCompacta TextBlock.nomeNaBarra">
    <Setter Property="MaxWidth" Value="100" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons,Segoe MDL2 Assets,Segoe UI Symbol" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
  </Style>

  <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
    <Setter Property="TextBlock.Foreground" Value="{DynamicResource Accent}" />
  </Style>

  <!-- entradas -->

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource Bg}" />
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="7,4" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Bg}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="MinHeight" Value="28" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
  </Style>

  <!-- listas -->

  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
  </Style>

  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgActive}" />
  </Style>

  <!-- abas -->

  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Height" Value="38" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
  </Style>

  <Style Selector="TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Text}" />
  </Style>

  <Style Selector="TabControl">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- containers -->

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource BgPanel}" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource BgRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>

  <!-- cartão do painel: é um Button para o clique valer no cartão inteiro, mas não
       deve parecer botão — daí herdar a moldura do card e só acender ao passar o mouse -->
  <Style Selector="Button.cartao">
    <Setter Property="Background" Value="{DynamicResource BgPanel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
    <!-- o estilo base de Button fixa Height 28; aqui o cartão cresce com o conteúdo -->
    <Setter Property="Height" Value="NaN" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Button.cartao /template/ ContentPresenter">
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="Button.cartao:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextFaint}" />
  </Style>

  <!-- cartão do painel que expande. Duas camadas: o fundo recorta o conteúdo no
       retângulo arredondado, e o contorno vem por cima, sozinho. Com a borda no mesmo
       Border do conteúdo, a faixa do grupo e o fundo do topo no hover cobriam a linha
       nos cantos e ela parecia cortada (EV05) -->
  <Style Selector="Border.cartaoFundo">
    <Setter Property="Background" Value="{DynamicResource BgPanel}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.cartaoContorno">
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="Panel.cartaoMoldura:pointerover > Border.cartaoContorno">
    <Setter Property="BorderBrush" Value="{DynamicResource TextFaint}" />
  </Style>

  <Style Selector="Button.cartaoTopo">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Height" Value="NaN" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.cartaoTopo:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
  </Style>

  <!-- título de grupo no painel: linha clicável discreta, como o grupo na árvore -->
  <Style Selector="Button.secaoTopo">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="4,3,10,3" />
    <Setter Property="Height" Value="NaN" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <Style Selector="Button.secaoTopo:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
  </Style>

  <Style Selector="Border.chip">
    <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="5,0" />
    <Setter Property="Margin" Value="0,0,5,0" />
  </Style>

  <!-- Barra de rolagem fina e sem setas. A barra permanente do tema Fluent traz
       setinhas nas pontas e um fundo próprio que, ao rolar, piscam como sujeira no
       canto. Aqui sobra o indicador: largura fixa, fundo transparente e cantos
       arredondados. A largura fixa é o que mantém o espaço reservado no layout. -->
  <Style Selector="ScrollBar /template/ RepeatButton#PART_LineUpButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="ScrollBar /template/ RepeatButton#PART_LineDownButton">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="9" />
    <Setter Property="MinWidth" Value="9" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ScrollBar:horizontal">
    <Setter Property="Height" Value="9" />
    <Setter Property="MinHeight" Value="9" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ScrollBar /template/ Border">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource Border}" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <Style Selector="ScrollBar:pointerover /template/ Thumb">
    <Setter Property="Background" Value="{DynamicResource TextFaint}" />
  </Style>

</Styles>
